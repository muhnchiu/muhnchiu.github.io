{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radar-shadow-validation-daily-schema-v1",
  "title": "Horizon Radar Shadow Validation Daily Evidence",
  "type": "object",
  "required": ["schemaVersion", "date", "validationRunIds", "sourcesExpected", "sourcesObserved", "sourcesNotObserved", "recordsReceived", "recordsCandidateReady", "recordsReceiptOnly", "identityReady", "identityUnresolved", "scoreReady", "scoreIncomplete", "securityResolved", "securityUnresolved", "recordsEvaluated", "wouldFilter", "wouldAction", "errors", "duplicateDeliveries", "deduplicatedRecords", "stateWriteFailures", "v1BehavioralDeltaCount", "productionRegistryWriteCount", "publisherInvocationCount", "deploymentCount", "silentFallbackCount", "policyDebtObserved", "stopConditionsTriggered", "dayStatus", "metrics"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "date": { "type": "string", "format": "date" },
    "generatedAt": { "type": ["string", "null"], "format": "date-time" },
    "validationRunIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "sourcesExpected": { "type": "array", "items": { "type": "string" } },
    "sourcesObserved": { "type": "array", "items": { "type": "string" } },
    "sourcesNotObserved": { "type": "array", "items": { "type": "string" } },
    "sourceStatuses": { "type": "object", "additionalProperties": { "enum": ["EXPECTED", "OBSERVED", "NOT_OBSERVED", "UNAVAILABLE"] } },
    "recordsReceived": { "type": "integer", "minimum": 0 },
    "recordsCandidateReady": { "type": "integer", "minimum": 0 },
    "recordsReceiptOnly": { "type": "integer", "minimum": 0 },
    "identityReady": { "type": "integer", "minimum": 0 },
    "identityUnresolved": { "type": "integer", "minimum": 0 },
    "scoreReady": { "type": "integer", "minimum": 0 },
    "scoreIncomplete": { "type": "integer", "minimum": 0 },
    "securityResolved": { "type": "integer", "minimum": 0 },
    "securityUnresolved": { "type": "integer", "minimum": 0 },
    "recordsEvaluated": { "type": "integer", "minimum": 0 },
    "wouldFilter": { "type": "integer", "minimum": 0 },
    "wouldAction": { "type": "integer", "minimum": 0 },
    "errors": { "type": "array", "items": { "type": "object", "required": ["recordId", "reasonCode"], "properties": { "recordId": { "type": ["string", "null"] }, "reasonCode": { "type": "string" }, "sampleRecordIds": { "type": "array", "maxItems": 10, "items": { "type": "string" } } }, "additionalProperties": false } },
    "duplicateDeliveries": { "type": "integer", "minimum": 0 },
    "deduplicatedRecords": { "type": "integer", "minimum": 0 },
    "stateWriteFailures": { "type": "integer", "minimum": 0 },
    "v1BehavioralDeltaCount": { "type": "integer", "minimum": 0 },
    "productionRegistryWriteCount": { "type": "integer", "minimum": 0 },
    "publisherInvocationCount": { "type": "integer", "minimum": 0 },
    "deploymentCount": { "type": "integer", "minimum": 0 },
    "silentFallbackCount": { "type": "integer", "minimum": 0 },
    "semanticNondeterminismCount": { "type": "integer", "minimum": 0 },
    "policyDebtObserved": { "type": "array", "items": { "type": "object", "required": ["debtId", "firstObservedAt", "lastObservedAt", "observationCount", "radars", "sourceFamilies", "reasonCode", "sampleRecordIds", "severity", "blocksShadow", "blocksProduction"], "properties": { "debtId": { "type": "string" }, "firstObservedAt": { "type": "string", "format": "date-time" }, "lastObservedAt": { "type": "string", "format": "date-time" }, "observationCount": { "type": "integer", "minimum": 1 }, "radars": { "type": "array", "items": { "type": "string" } }, "sourceFamilies": { "type": "array", "items": { "type": "string" } }, "reasonCode": { "type": "string" }, "sampleRecordIds": { "type": "array", "maxItems": 10, "items": { "type": "string" } }, "severity": { "type": "string" }, "blocksShadow": { "type": "boolean", "const": false }, "blocksProduction": { "type": "boolean" } }, "additionalProperties": false } },
    "stopConditionsTriggered": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "stopEvidence": { "type": "array", "items": { "type": "object" } },
    "dayStatus": { "enum": ["PASS", "PASS_WITH_DEBT", "FAILED"] },
    "metrics": { "type": "object", "required": ["totalRuns", "successfulRuns", "failedRuns", "totalRecords", "receiptOnlyRate", "identityReadyRate", "scoreReadyRate", "securityResolvedRate", "wouldFilterRate", "wouldActionRate", "errorRate", "duplicateRate", "sourceObservationRate", "v1BehavioralDeltaCount", "productionRegistryWriteCount", "publisherInvocationCount", "deploymentCount", "silentFallbackCount", "semanticNondeterminismCount"], "properties": { "totalRuns": { "type": "integer", "minimum": 0 }, "successfulRuns": { "type": "integer", "minimum": 0 }, "failedRuns": { "type": "integer", "minimum": 0 }, "totalRecords": { "type": "integer", "minimum": 0 }, "receiptOnlyRate": { "type": "number", "minimum": 0, "maximum": 1 }, "identityReadyRate": { "type": "number", "minimum": 0, "maximum": 1 }, "scoreReadyRate": { "type": "number", "minimum": 0, "maximum": 1 }, "securityResolvedRate": { "type": "number", "minimum": 0, "maximum": 1 }, "wouldFilterRate": { "type": "number", "minimum": 0, "maximum": 1 }, "wouldActionRate": { "type": "number", "minimum": 0, "maximum": 1 }, "errorRate": { "type": "number", "minimum": 0, "maximum": 1 }, "duplicateRate": { "type": "number", "minimum": 0, "maximum": 1 }, "sourceObservationRate": { "type": "number", "minimum": 0, "maximum": 1 }, "v1BehavioralDeltaCount": { "type": "integer", "minimum": 0 }, "productionRegistryWriteCount": { "type": "integer", "minimum": 0 }, "publisherInvocationCount": { "type": "integer", "minimum": 0 }, "deploymentCount": { "type": "integer", "minimum": 0 }, "silentFallbackCount": { "type": "integer", "minimum": 0 }, "semanticNondeterminismCount": { "type": "integer", "minimum": 0 } }, "additionalProperties": true }
  },
  "additionalProperties": true
}
