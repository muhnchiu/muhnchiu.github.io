---
const { topics } = Astro.props;
const icons = ['▱', '⚙', '</>', '⌁', '♢', '⌕'];
const accents = ['blue', 'green', 'blue', 'purple', 'red', 'blue'];
---
<section class="section topics-section"><div class="container"><div class="section-header"><div><h2>长期议题</h2><p class="section-sub">持续追踪那些正在改变技术版图的关键方向。</p></div><a class="all-link" href="/topics">查看全部议题　→</a></div>{topics.length ? <div class="topics-grid">{topics.map((topic, index) => <a href={`/topics/${topic.slug}`} class={`topic-card ${accents[index % accents.length]}`}><div><span class="topic-icon">{icons[index % icons.length]}</span><h3>{topic.name}</h3></div><p><b>{topic.research}</b> 研究<br /><b>{topic.signals}</b> 信号</p><span>更新 {topic.updatedLabel}　→</span></a>)}</div> : <div class="topics-empty">暂无足够的议题数据。</div>}</div></section>
<style>
.topics-section { padding-top: 0; padding-bottom: 52px; }.all-link { font-size: .72rem; color: #315d88; }.topics-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }.topic-card { min-height: 132px; padding: 14px; border: 1px solid #dce8f1; border-radius: 6px; background: linear-gradient(135deg, #fff, var(--topic-tint)); }.topic-card:hover { color: inherit; border-color: var(--topic); box-shadow: var(--shadow-md); transform: translateY(-2px); }.topic-card.blue { --topic: #1688ef; --topic-tint: #eef9ff; }.topic-card.green { --topic: #139566; --topic-tint: #edfbf5; }.topic-card.purple { --topic: #6156ce; --topic-tint: #f4f2ff; }.topic-card.red { --topic: #d9383e; --topic-tint: #fff3f3; }.topic-card > div { display: flex; align-items: center; gap: 9px; }.topic-icon { display: grid; place-items: center; width: 19px; height: 19px; color: var(--topic); font-family: var(--font-mono); font-size: .8rem; }.topic-card h3 { font-size: .65rem; font-weight: 700; }.topic-card p { margin: 15px 0 11px 28px; font-size: .61rem; line-height: 1.5; color: #66798e; }.topic-card p b { color: #263d57; }.topic-card > span { font-size: .56rem; color: #74899e; }.topics-empty { padding: 35px 0; border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); color: var(--text-secondary); font-size: .86rem; }@media (max-width: 1024px) { .topics-grid { grid-template-columns: repeat(3, 1fr); } }@media (max-width: 520px) { .topics-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
