---
const topics = [
  ['▱', 'Agent Systems', 12, 47, '2h ago', 'blue'], ['⚙', 'Local AI', 8, 32, '4h ago', 'green'], ['</>', 'AI Coding', 15, 56, '6h ago', 'blue'], ['⌁', 'MCP', 6, 28, '8h ago', 'purple'], ['♢', 'Security', 10, 35, '1h ago', 'red'], ['⌕', 'Developer Tools', 14, 49, '3h ago', 'blue'],
];
---
<section class="section topics-section"><div class="container"><div class="section-header"><div><h2>RESEARCH TOPICS</h2><p class="section-sub">What I’m continuously tracking.</p></div><a class="all-link" href="/topics">View all topics　→</a></div><div class="topics-grid">{topics.map(t => <a href={`/topics/${t[1].toLowerCase().replace(' ', '-')}`} class={`topic-card ${t[5]}`}><div><span class="topic-icon">{t[0]}</span><h3>{t[1]}</h3></div><p><b>{t[2]}</b> Research<br /><b>{t[3]}</b> Signals</p><span>Updated {t[4]}　→</span></a>)}</div></div></section>
<style>
.topics-section { padding-top: 0; padding-bottom: 52px; }.all-link { font-size: .72rem; color: #315d88; }.topics-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }.topic-card { min-height: 132px; padding: 14px; border: 1px solid #dce8f1; border-radius: 6px; background: linear-gradient(135deg, #fff, var(--topic-tint)); }.topic-card:hover { color: inherit; border-color: var(--topic); box-shadow: var(--shadow-md); transform: translateY(-2px); }.topic-card.blue { --topic: #1688ef; --topic-tint: #eef9ff; }.topic-card.green { --topic: #139566; --topic-tint: #edfbf5; }.topic-card.purple { --topic: #6156ce; --topic-tint: #f4f2ff; }.topic-card.red { --topic: #d9383e; --topic-tint: #fff3f3; }.topic-card > div { display: flex; align-items: center; gap: 9px; }.topic-icon { display: grid; place-items: center; width: 19px; height: 19px; color: var(--topic); font-family: var(--font-mono); font-size: .8rem; }.topic-card h3 { font-size: .65rem; font-weight: 700; }.topic-card p { margin: 15px 0 11px 28px; font-size: .61rem; line-height: 1.5; color: #66798e; }.topic-card p b { color: #263d57; }.topic-card > span { margin-left: 0; font-size: .56rem; color: #74899e; }
@media (max-width: 1024px) { .topics-grid { grid-template-columns: repeat(3, 1fr); } } @media (max-width: 520px) { .topics-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
