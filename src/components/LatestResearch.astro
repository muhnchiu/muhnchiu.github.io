---
const { featured, recent } = Astro.props;
const displayDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
---
<section id="research" class="section research-section">
  <div class="container">
    <div class="section-header"><div><h2>近期研究</h2><p class="section-sub">从每日信号出发，追踪技术背后的长期变量。</p></div><a class="all-link" href="/research">查看全部研究　→</a></div>
    {featured ? <div class="research-layout">
      <article class="research-feature"><div class="research-copy"><div class="research-pills">{featured.data.category.map((category) => <span>{category}</span>)}</div><h3>{featured.data.title}</h3><p class="research-subtitle">{featured.data.subtitle}</p><p class="research-desc">{featured.data.source}</p><div class="research-bottom"><span>UPDATED {displayDate(featured.data.updated)}　·　{featured.data.confidence.toUpperCase()} CONFIDENCE</span><a href={`/research/${featured.data.slug}`} class="read-button">阅读研究　→</a></div></div><div class="research-art" aria-hidden="true"><span>RESEARCH<br />LONG-TERM<br />VARIABLES<br />BEHIND<br />THE SIGNALS.</span><i></i><b></b><em></em></div></article>
      <div class="recent-list">{recent.length ? recent.map((entry) => <a href={`/research/${entry.data.slug}`} class="recent-item"><span>{displayDate(entry.data.updated).slice(5)}</span><div><h3>{entry.data.title}</h3><p>{entry.data.topics.join('　').toUpperCase()}</p></div></a>) : <p class="empty">暂无更多公开研究。</p>}</div>
    </div> : <div class="research-empty">暂无公开研究。</div>}
  </div>
</section>
<style>
.research-section { padding-top: 0; padding-bottom: 55px; }.all-link { font-size: .72rem; color: #315d88; }.research-layout { display: grid; grid-template-columns: 2.1fr 1fr; gap: 20px; }.research-feature { position: relative; min-height: 291px; overflow: hidden; padding: 25px 21px 17px; border: 1px solid #dceaf5; border-radius: 7px; background: linear-gradient(128deg, #f8fcff 8%, #e5f4ff 100%); }.research-copy { position: relative; z-index: 2; max-width: 69%; }.research-pills { display: flex; flex-wrap: wrap; gap: 7px; }.research-pills span { padding: 3px 7px; border-radius: 4px; background: #dcecff; color: #2c659b; font-family: var(--font-mono); font-size: .54rem; letter-spacing: .05em; }.research-feature h3 { margin-top: 17px; font-size: 1.6rem; line-height: 1.12; letter-spacing: -.035em; }.research-subtitle { margin-top: 5px; font-size: 1.05rem; color: #233c5d; }.research-desc { margin-top: 19px; font-size: .75rem; line-height: 1.65; color: #59708b; }.research-bottom { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 22px; font-family: var(--font-mono); font-size: .59rem; color: #55708d; }.read-button { padding: 9px 13px; border-radius: 4px; background: #1e4773; color: #fff; font-family: var(--font-sans); font-size: .68rem; }.read-button:hover { color: #fff; background: #286caa; }.research-art { position: absolute; inset: 0 0 0 auto; width: 45%; overflow: hidden; background: radial-gradient(circle at 88% 50%, rgba(255,255,255,.9), transparent 34%); }.research-art span { position: absolute; top: 47px; right: 18px; font-family: var(--font-mono); font-size: .55rem; line-height: 1.65; letter-spacing: .1em; color: #6386ab; }.research-art i,.research-art b,.research-art em { position: absolute; bottom: 26px; display: block; width: 39px; height: 126px; transform: skewY(38deg); transform-origin: bottom; background: linear-gradient(90deg, rgba(83,155,221,.52), rgba(207,235,255,.12)); box-shadow: 11px 6px 0 rgba(103,171,228,.15); }.research-art i { left: 42px; height: 100px; }.research-art b { left: 85px; height: 143px; }.research-art em { left: 128px; height: 88px; }.recent-list { border-top: 1px solid var(--border-subtle); }.recent-item { display: grid; grid-template-columns: 42px 1fr; gap: 9px; min-height: 58px; padding: 8px 0; border-bottom: 1px solid var(--border-subtle); }.recent-item:hover { color: inherit; background: #fbfdff; }.recent-item > span { font-family: var(--font-mono); font-size: .68rem; color: #465f7b; }.recent-item h3 { font-size: .76rem; font-weight: 700; line-height: 1.35; }.recent-item p { margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--font-mono); font-size: .54rem; letter-spacing: .04em; color: #708da9; }.research-empty { padding: 42px 20px; border: 1px dashed var(--border-default); border-radius: var(--radius-md); color: var(--text-secondary); }.empty { padding: 18px 0; color: var(--text-secondary); font-size: .8rem; }@media (max-width: 850px) { .research-layout { grid-template-columns: 1fr; }.research-copy { max-width: 66%; } }@media (max-width: 520px) { .research-copy { max-width: 100%; }.research-art { opacity: .26; }.research-feature h3 { font-size: 1.35rem; }.research-bottom { align-items: flex-start; flex-direction: column; } }
</style>
