---
import { statusLabel, formatDate } from '../data/research';
import { getTopicName, getCanonicalTopicSlugs } from '../data/topics';
const { entry } = Astro.props;
const { data } = entry;
---
<a href={`/research/${data.slug}/`} class="research-card" data-status={data.status} data-categories={data.category.join('|')}>
  <div class="file-meta"><span>RESEARCH FILE</span><time datetime={data.updated.toISOString().slice(0,10)}>{formatDate(data.updated)}</time><span class="file-status">{statusLabel(data.status)}</span></div>
  <div class="file-copy"><p class="file-topics">{getCanonicalTopicSlugs(data.topics).slice(0,2).map(getTopicName).join(' / ') || data.category.slice(0,2).join(' / ')}</p><h3>{data.title}</h3><p class="file-summary">{data.subtitle}</p></div>
  <span class="file-arrow" aria-hidden="true">↗</span>
</a>
