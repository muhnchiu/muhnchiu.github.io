---
const briefs = [
  { tag: 'SECURITY / VULNERABILITY', action: 'ACTION', title: 'CVE-2024-XXXXX：影响主流开源组件的高危漏洞', summary: '存在被利用风险，建议尽快评估并安排补丁。', time: '2h ago' },
  { tag: 'AI / MODEL', action: 'TEST', title: 'Claude 3.5 Sonnet 新能力更新', summary: '在工具调用和代码能力上有明显提升，值得进入测试列表。', time: '4h ago' },
  { tag: 'DEVELOPER / TOOL', action: 'WATCH', title: 'VS Code Insiders 推出 AI 原生工作区', summary: '新的 Agent 模式正在逐步开放，建议持续关注。', time: '6h ago' },
  { tag: 'AI / RESEARCH', action: 'READ', title: 'OpenAI 发布长上下文评测基准', summary: '为长上下文能力提供了更系统的评估方法，有助于理解模型边界。', time: '8h ago' },
  { tag: 'APP / SOFTWARE', action: 'READ', title: 'Notion 推出新一代 AI 知识管理功能', summary: '在企业知识协作方向迈出重要一步，值得关注其后续发展。', time: '10h ago' },
];
---

<section class="section brief-section">
  <div class="container">
    <div class="section-header"><div><h2>TODAY’S BRIEF</h2><p class="section-sub">基于今日雷达结果的关键信号与行动建议。</p></div><a href="/radar" class="all-link">View all signals　→</a></div>
    <div class="briefs">
      {briefs.map((b, index) => (
        <article class="brief-item">
          <span class="brief-num">{String(index + 1).padStart(2, '0')}</span>
          <span class={`brief-action ${b.action.toLowerCase()}`}>{b.action}</span>
          <span class="brief-tag">{b.tag}</span>
          <div class="brief-content"><h3>{b.title}</h3><p>{b.summary}</p></div>
          <time>{b.time}</time><span class="brief-arrow">→</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.brief-section { padding-top: 0; padding-bottom: 56px; }
.all-link { font-size: .72rem; color: #315d88; }
.briefs { border-top: 1px solid var(--border-subtle); }
.brief-item { display: grid; grid-template-columns: 30px 92px 150px minmax(0, 1fr) 48px 16px; align-items: center; gap: 10px; min-height: 64px; border-bottom: 1px solid var(--border-subtle); transition: background var(--transition), padding var(--transition); }
.brief-item:hover { padding: 0 8px; background: rgba(237,247,255,.42); }
.brief-num { font-family: var(--font-mono); font-size: .8rem; color: #50647d; }
.brief-action { display: inline-flex; justify-content: center; width: fit-content; min-width: 53px; padding: 4px 8px; border-radius: 5px; font-family: var(--font-mono); font-size: .6rem; letter-spacing: .05em; }
.brief-action.action { color: #b91c25; background: #ffe4e5; }.brief-action.test { color: #1762ae; background: #e0efff; }.brief-action.watch { color: #168153; background: #e0f7e9; }.brief-action.read { color: #566275; background: #eef1f5; }
.brief-tag { font-family: var(--font-mono); font-size: .56rem; letter-spacing: .03em; color: #748398; }
.brief-content h3 { font-size: .75rem; font-weight: 650; line-height: 1.3; }.brief-content p { margin-top: 2px; font-size: .69rem; color: #68778a; line-height: 1.35; }
time { font-family: var(--font-mono); font-size: .56rem; color: #7d8b9d; white-space: nowrap; }.brief-arrow { color: #55718d; }
@media (max-width: 720px) { .brief-item { grid-template-columns: 28px 65px 1fr 14px; gap: 8px; padding: 10px 0; } .brief-tag, time { display: none; } .brief-content p { font-size: .65rem; } }
</style>
