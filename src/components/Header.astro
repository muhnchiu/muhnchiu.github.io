---
import FieldIcon from './FieldIcon.astro';
const navItems = [
  { label: '雷达', href: '/radar' },
  { label: '洞见', href: '/research' },
  { label: '脉络', href: '/topics' },
  { label: '方略', href: '/stack' },
  { label: '自省', href: '/about' },
];
const activePath = Astro.url.pathname.replace(/^\/zh-hans(?=\/)/, '').replace(/\/$/, '');
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <span class="logo-text">HORIZON</span>
      <span class="logo-dot"></span>
      <span class="logo-live">LIVE</span>
    </a>
    <nav class="nav" aria-label="主导航">
      {navItems.map(item => (
        <a href={item.href} class="nav-link" aria-current={activePath === item.href || activePath.startsWith(`${item.href}/`) ? 'page' : undefined}><FieldIcon name={item.href.slice(1)} />{item.label}</a>
      ))}
    </nav>
    <details class="mobile-navigation">
      <summary aria-label="展开主导航">菜单</summary>
      <nav aria-label="主导航">
        {navItems.map(item => <a href={item.href} aria-current={activePath === item.href || activePath.startsWith(`${item.href}/`) ? 'page' : undefined}><FieldIcon name={item.href.slice(1)} />{item.label}</a>)}
      </nav>
    </details>
    <div class="header-tools" aria-label="站点工具">
      <nav class="language-switch" aria-label="文字版本">
        <a href="/" data-language="zh-Hant" aria-label="繁体中文"><span data-no-convert>繁</span></a>
        <span aria-hidden="true">/</span>
        <a href="/zh-hans/" data-language="zh-Hans" aria-label="简体中文"><span data-no-convert>简</span></a>
      </nav>
      <a class="icon-button" href="/search/" aria-label="搜索">
        <FieldIcon name="search" />
      </a>
      <div class="theme-control">
        <button class="icon-button theme-trigger" type="button" aria-label="切换主题" aria-haspopup="true" aria-expanded="false" aria-controls="theme-options">
          <svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.6"></circle><path d="M12 2.5v2M12 19.5v2M21.5 12h-2M4.5 12h-2M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4M18.7 18.7l-1.4-1.4M6.7 6.7 5.3 5.3"></path></svg>
          <svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.4A8.4 8.4 0 0 1 9.6 4 8.5 8.5 0 1 0 20 14.4Z"></path></svg>
          <svg class="theme-icon theme-icon-system" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
        </button>
        <div class="theme-popover" id="theme-options" role="group" aria-label="主题模式" hidden>
          <button type="button" data-theme-choice="light" aria-pressed="false">浅色</button>
          <button type="button" data-theme-choice="dark" aria-pressed="false">深色</button>
          <button type="button" data-theme-choice="system" aria-pressed="true">跟随系统</button>
        </div>
      </div>

    </div>
  </div>
</header>

<script>
  const mobileNavigation = document.querySelector<HTMLDetailsElement>('.mobile-navigation');
  document.addEventListener('click', event => {
    if (event.target instanceof Node && !mobileNavigation?.contains(event.target) && mobileNavigation) mobileNavigation.open = false;
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && mobileNavigation?.open) {
      mobileNavigation.open = false;
      mobileNavigation.querySelector('summary')?.focus();
    }
  });
  const themeRoot = document.documentElement;
  const themeMedia = window.matchMedia('(prefers-color-scheme: dark)');
  const themeTrigger = document.querySelector<HTMLButtonElement>('.theme-trigger');
  const themeOptions = document.querySelector<HTMLElement>('#theme-options');
  const themeChoices = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')];
  const getPreference = () => themeRoot.dataset.themePreference ?? 'system';
  const syncThemeControl = () => {
    const preference = getPreference();
    themeChoices.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.themeChoice === preference)));
    const label = themeRoot.lang === 'zh-Hant' ? '切換主題' : '切换主题';
    themeTrigger?.setAttribute('aria-label', `${label}：${themeChoices.find((button) => button.dataset.themeChoice === preference)?.textContent ?? ''}`);
  };
  const applyTheme = (preference: string) => {
    themeRoot.dataset.themePreference = preference;
    themeRoot.dataset.theme = preference === 'system' ? (themeMedia.matches ? 'dark' : 'light') : preference;
    syncThemeControl();
  };
  const closeThemeOptions = () => {
    if (themeOptions) themeOptions.hidden = true;
    themeTrigger?.setAttribute('aria-expanded', 'false');
  };
  themeTrigger?.addEventListener('click', () => {
    if (!themeOptions) return;
    themeOptions.hidden = !themeOptions.hidden;
    themeTrigger.setAttribute('aria-expanded', String(!themeOptions.hidden));
    if (!themeOptions.hidden) themeChoices.find((button) => button.dataset.themeChoice === getPreference())?.focus();
  });
  themeChoices.forEach((button) => button.addEventListener('click', () => {
    const preference = button.dataset.themeChoice;
    if (!preference) return;
    try { localStorage.setItem('horizon-theme', preference); } catch { /* Theme still works for this page. */ }
    applyTheme(preference);
    closeThemeOptions();
    themeTrigger?.focus();
  }));
  themeMedia.addEventListener('change', () => {
    if (getPreference() === 'system') applyTheme('system');
  });
  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !themeOptions?.contains(event.target) && !themeTrigger?.contains(event.target)) closeThemeOptions();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && themeOptions && !themeOptions.hidden) { closeThemeOptions(); themeTrigger?.focus(); }
  });
  syncThemeControl();
  window.addEventListener('load', () => requestAnimationFrame(() => themeRoot.classList.add('theme-ready')), { once: true });

  document.addEventListener('keydown', (event) => {
    if (event.isComposing || event.defaultPrevented) return;
    const target = event.target;
    if (target instanceof Element && target.closest('input, textarea, select, [contenteditable="true"]')) return;
    const slash = event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey;
    const command = event.key.toLowerCase() === 'k' && (event.metaKey || event.ctrlKey) && !event.altKey;
    if (!slash && !command) return;
    event.preventDefault();
    const input = document.querySelector<HTMLInputElement>('#site-search-input');
    if (input) input.focus();
    else window.location.assign(document.documentElement.lang === 'zh-Hans' ? '/zh-hans/search/' : '/search/');
  });
</script>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  height: var(--header-height);
  background: var(--bg-glass);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-subtle);
}

.header-inner {
  height: var(--header-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  display: flex;
  align-items: center;
  gap: 6px;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.logo-text {
  font-family: var(--font-ui);
  font-size: 1rem;
  color: var(--text-primary);
}

.logo-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--status-live);
  box-shadow: 0 0 6px var(--status-live-soft);
  animation: pulse 2s ease-in-out infinite;
}

.logo-live {
  font-family: var(--font-mono);
  font-size: 0.625rem;
  letter-spacing: 0.1em;
  color: var(--text-tertiary);
}

.nav {
  display: flex;
  gap: var(--space-lg);
}

.header-tools { display: flex; align-items: center; gap: 9px; margin-left: 22px; }
.language-switch { display: flex; align-items: center; gap: 5px; margin-right: 5px; padding-right: 12px; border-right: 1px solid var(--border-subtle); font-family: var(--font-mono); font-size: .7rem; color: var(--text-tertiary); }
.language-switch a { color: var(--text-tertiary); }
.language-switch a:hover, .language-switch a[aria-current="page"] { color: var(--text-primary); font-weight: 700; }
.icon-button { display: grid; place-items: center; width: 28px; height: 28px; padding: 0; background: transparent; border: 0; color: var(--text-primary); cursor: pointer; }
.icon-button svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; }
.theme-control { position: relative; flex: none; }
.theme-icon { display: none; }
:global(html[data-theme-preference='light']) .theme-icon-light,
:global(html[data-theme-preference='dark']) .theme-icon-dark,
:global(html[data-theme-preference='system']) .theme-icon-system { display: block; }
.theme-popover { position: absolute; top: calc(100% + 14px); right: -8px; z-index: 120; width: 148px; padding: 5px; border: 1px solid var(--border-default); border-radius: var(--radius-sm); background: var(--bg-elevated); box-shadow: var(--shadow-lg); }
.theme-popover[hidden] { display: none; }
.theme-popover button { display: block; width: 100%; padding: 8px 10px; border: 0; border-radius: 4px; background: transparent; color: var(--text-secondary); cursor: pointer; font-size: .76rem; text-align: left; }
.theme-popover button:hover, .theme-popover button[aria-pressed='true'] { background: var(--accent-tech-soft); color: var(--text-primary); }
.theme-popover button[aria-pressed='true']::after { content: '✓'; float: right; color: var(--accent-text); }
.header-slogan { padding-left: 14px; border-left: 1px solid var(--border-subtle); font-size: 0.64rem; color: var(--text-tertiary); white-space: nowrap; }

.nav-link {
  font-size: var(--fs-small);
  font-weight: 500;
  color: var(--text-secondary);
  transition: color var(--transition);
}

.nav-link:hover, .nav-link[aria-current="page"] {
  color: var(--text-primary);
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

 .mobile-navigation { display: none; position: relative; margin-left: auto; }
.mobile-navigation summary { cursor: pointer; padding: 10px; font-size: .82rem; color: var(--text-secondary); }
.mobile-navigation nav { position: absolute; top: calc(100% + 10px); right: 0; width: 180px; padding: 8px; border: 1px solid var(--border-default); border-radius: 8px; background: var(--bg-elevated); box-shadow: var(--shadow-lg); }
.mobile-navigation nav a { display: block; padding: 12px; font-size: .9rem; }
.mobile-navigation nav a[aria-current="page"] { color: var(--accent-text); background: var(--accent-tech-soft); border-radius: 4px; }
@media (max-width: 1024px) {
  .mobile-navigation { display: block; }

  .nav {
    display: none;
  }
  .header-slogan { display: none; }
  .header-tools { margin-left: 8px; }
}
</style>
