---
const stack = [['▱', 'AI', 'OpenAI · Qwen · GLM · OpenRouter'], ['▣', 'DEVELOPER', 'Claude Code · VS Code Insiders · Ghostty'], ['▰', 'KNOWLEDGE', 'Obsidian · GitHub · Horizon'], ['▦', 'OTHER', 'Notion · Raycast · Arc']];
---
<section class="section stack-section"><div class="container"><div class="section-header"><div><h2>我的工具栈</h2><p class="section-sub">真正进入日常工作流，并长期留下来的工具。</p></div><a class="all-link" href="/stack">查看我的工具栈　→</a></div><div class="stack-grid">{stack.map(s => <div class="stack-card"><span>{s[0]}</span><div><h3>{s[1]}</h3><p>{s[2]}</p></div></div>)}</div></div></section>
<style>
.stack-section { padding-top: 0; padding-bottom: 35px; }.all-link { font-size: .72rem; color: #315d88; }.stack-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }.stack-card { display: flex; align-items: center; gap: 12px; padding: 12px; border: 1px solid var(--border-subtle); border-radius: 5px; background: rgba(255,255,255,.54); }.stack-card > span { display: grid; place-items: center; width: 29px; height: 29px; border-radius: 5px; background: #edf3f9; color: #314e70; font-size: 1rem; }.stack-card h3 { font-size: .65rem; }.stack-card p { margin-top: 3px; font-size: .59rem; color: #6c7d90; line-height: 1.35; }
@media (max-width: 768px) { .stack-grid { grid-template-columns: repeat(2, 1fr); } } @media (max-width: 460px) { .stack-grid { grid-template-columns: 1fr; } }
</style>
