---
// Hero — the site’s operating-system-like introduction
const { status } = Astro.props;
---
<section class="hero">
  <div class="hero-atmosphere" aria-hidden="true">
    <div class="hero-sun"></div>
    <div class="hero-mountain mountain-back"></div>
    <div class="hero-mountain mountain-front"></div>
    <div class="hero-grid"></div>
  </div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="hero-label mono-label">技术情报 · 独立研究</span>
      <h1 class="hero-title">HORIZON</h1>
      <p class="hero-tagline">追踪技术变化，辨识趋势信号，沉淀长期判断。</p>
      <p class="hero-tags">AI <i>•</i> 开发工具 <i>•</i> 安全 <i>•</i> 软件 <i>•</i> Agent Skills</p>
      <div class="hero-cta">
        <a href="#signals" class="btn btn-primary">查看今日雷达 <span>→</span></a>
        <a href="#research" class="btn btn-secondary">进入深度研究</a>
      </div>
    </div>
    <div class="hero-aside">
      <p class="hero-manifesto">从噪声中识别<br />信号，在变化中<br />形成长期判断。</p>
      <div class="system-status">
        <span class="status-label mono-label">情报系统</span>
        <div class="status-row"><span class="status-dot"></span><span class="status-text">{status.activeRadarCount ? `${status.activeRadarCount} 个雷达运行中` : '今日雷达尚未完成更新'}</span></div>
        <div class="status-scan">最近扫描&nbsp;&nbsp;{status.latestRadarDate ?? '暂无公开日报'}</div>
      </div>
    </div>
  </div>
</section>

<style>
.hero { position: relative; isolation: isolate; overflow: hidden; min-height: 420px; padding: 66px 0 54px; background: var(--hero-gradient); border-bottom: 1px solid var(--hero-border); }
.hero-atmosphere { position: absolute; inset: 0; overflow: hidden; z-index: -1; }
.hero-sun { position: absolute; top: 44px; right: 29%; width: 146px; aspect-ratio: 1; border-radius: 50%; background: var(--hero-sun); box-shadow: var(--hero-sun-shadow); }
.hero-mountain { position: absolute; bottom: -1px; right: -5%; width: 69%; height: 53%; opacity: .76; filter: var(--hero-mountain-filter); }
.mountain-back { background: var(--hero-mountain-back); clip-path: polygon(0 76%, 13% 48%, 22% 65%, 39% 27%, 50% 52%, 69% 10%, 82% 39%, 100% 0, 100% 100%, 0 100%); }
.mountain-front { opacity: .6; background: var(--hero-mountain-front); clip-path: polygon(0 100%, 0 82%, 17% 60%, 31% 75%, 49% 40%, 61% 65%, 79% 21%, 90% 47%, 100% 28%, 100% 100%); }
.hero-grid { position: absolute; inset: 0; opacity: .36; background-image: linear-gradient(var(--hero-grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--hero-grid-line) 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(90deg, transparent 25%, black 78%, transparent); }
.hero-inner { display: flex; align-items: stretch; justify-content: space-between; min-height: 300px; }
.hero-copy { align-self: center; max-width: 680px; }
.hero-label { font-family: var(--font-display); color: var(--ink-blue); font-size: .72rem; letter-spacing: .18em; }
.hero-title { margin: 9px 0 8px; font-family: var(--font-ui); font-size: var(--fs-hero); font-weight: 800; letter-spacing: -.065em; line-height: .96; color: var(--ink-blue-deep); }
.hero-tagline { font-family: var(--font-display); font-size: 1.15rem; font-weight: 400; color: var(--ink-blue-deep); }
.hero-tags { margin-top: 9px; font-family: var(--font-mono); font-size: .74rem; color: var(--ink-blue-soft); }
.hero-tags i { margin: 0 7px; font-style: normal; color: var(--text-tertiary); }
.hero-cta { display: flex; gap: 12px; margin-top: 21px; }
.btn { display: inline-flex; align-items: center; gap: 10px; padding: 10px 19px; border-radius: 5px; border: 1px solid transparent; font-size: .8rem; font-weight: 550; transition: all var(--transition); }
.btn-primary { color: var(--text-on-accent); background: var(--button-primary); box-shadow: var(--shadow-md); }
.btn-primary:hover { color: var(--text-on-accent); background: var(--button-primary-hover); transform: translateY(-1px); }
.btn-secondary { color: var(--ink-blue-deep); border-color: var(--button-secondary-border); background: var(--button-secondary); }
.btn-secondary:hover { color: var(--ink-blue); border-color: var(--button-secondary-hover-border); background: var(--bg-surface); }
.hero-aside { display: flex; flex-direction: column; justify-content: space-between; width: 252px; padding: 0 0 0 31px; border-left: 1px solid var(--border-default); }
.hero-manifesto { font-size: .61rem; line-height: 1.7; letter-spacing: .1em; color: var(--ink-blue-soft); }
.system-status { padding-top: 15px; }
.status-label { display: block; margin-bottom: 8px; color: var(--ink-blue-soft); }
.status-row { display: flex; align-items: center; gap: 10px; }
.status-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--status-live); box-shadow: 0 0 0 3px var(--status-live-soft); }
.status-text { font-family: var(--font-mono); font-size: .72rem; font-weight: 600; color: var(--ink-blue-deep); }
.status-scan { margin-top: 9px; font-family: var(--font-mono); font-size: .56rem; letter-spacing: .04em; color: var(--ink-blue-soft); }
@media (max-width: 768px) { .hero { min-height: 500px; padding: 56px 0 44px; } .hero-inner { flex-direction: column; } .hero-aside { width: 100%; min-height: 112px; margin-top: 42px; padding-left: 0; border-left: 0; border-top: 1px solid var(--border-default); padding-top: 15px; } .hero-sun { right: 4%; } .hero-mountain { width: 120%; right: -40%; height: 34%; } }
</style>
