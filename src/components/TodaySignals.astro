---
const radars = [
  { name: 'AI', icon: '✦', signals: 3, states: ['2 TEST', '1 WATCH'], href: '/radar/ai', accent: 'blue' },
  { name: 'DEVELOPER', icon: '</>', signals: 4, states: ['1 TEST', '2 WATCH', '1 READ'], href: '/radar/dev', accent: 'green' },
  { name: 'SECURITY', icon: '♢', signals: 2, states: ['1 ACTION', '1 WATCH'], href: '/radar/security', accent: 'red' },
  { name: 'APP / SOFTWARE', icon: '◇', signals: 5, states: ['2 TEST', '2 WATCH', '1 READ'], href: '/radar/app', accent: 'purple' },
  { name: 'AGENT SKILLS', icon: '⌘', signals: 6, states: ['3 EXPLORE', '2 WATCH', '1 READ'], href: '/radar/skill', accent: 'orange' },
];
---

<section id="signals" class="section signals-section">
  <div class="container">
    <div class="section-header">
      <div><h2>TODAY’S SIGNALS</h2><p class="section-sub">What actually matters today.</p></div>
      <div class="signals-heading-right"><span class="section-date">2026.09.23</span><span class="pager" aria-hidden="true">‹　›</span></div>
    </div>
    <div class="signals-grid">
      {radars.map(r => (
        <a href={r.href} class={`signal-card ${r.accent}`}>
          <div class="signal-name"><span class="signal-icon">{r.icon}</span>{r.name}</div>
          <strong class="radar-count">{String(r.signals).padStart(2, '0')}</strong>
          <span class="radar-label">SIGNALS</span>
          <div class="signal-states">{r.states.map(state => <span>{state}</span>)}</div>
          <span class="card-arrow">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
.signals-section { padding-top: 29px; padding-bottom: 58px; }
.section-header { margin-bottom: 15px; }
.section-header h2 { font-size: 1.32rem; }
.section-sub { margin-top: -1px; }
.signals-heading-right { display: flex; align-items: center; gap: 24px; }
.section-date { font-family: var(--font-mono); font-size: .71rem; letter-spacing: .07em; color: #55708e; }
.pager { padding: 6px 10px; border: 1px solid var(--border-subtle); border-radius: 4px; color: #60758d; font-size: 1rem; letter-spacing: .14em; }
.signals-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
.signal-card { position: relative; display: flex; flex-direction: column; min-height: 151px; padding: 16px 14px; overflow: hidden; border: 1px solid color-mix(in srgb, var(--tint) 33%, #dce7ef); border-radius: 7px; background: linear-gradient(135deg, #fff, var(--tint)); transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition); }
.signal-card:hover { color: inherit; border-color: var(--tone); box-shadow: 0 9px 20px color-mix(in srgb, var(--tone) 15%, transparent); transform: translateY(-2px); }
.signal-card.blue { --tone: #1688ef; --tint: #e7f8ff; }.signal-card.green { --tone: #159567; --tint: #ebfbf5; }.signal-card.red { --tone: #d9393e; --tint: #fff0f1; }.signal-card.purple { --tone: #594bc6; --tint: #f1f0ff; }.signal-card.orange { --tone: #b66c00; --tint: #fff8e7; }
.signal-name { display: flex; align-items: center; gap: 9px; font-size: .65rem; font-weight: 700; color: color-mix(in srgb, var(--tone) 70%, #1a2c42); }
.signal-icon { display: grid; place-items: center; width: 18px; height: 18px; font-family: var(--font-mono); font-size: .82rem; color: var(--tone); }
.radar-count { margin-top: 15px; font-family: var(--font-mono); font-size: 2rem; font-weight: 500; line-height: .9; color: color-mix(in srgb, var(--tone) 72%, #1a2b43); }
.radar-label { margin-top: 7px; font-family: var(--font-mono); font-size: .57rem; letter-spacing: .1em; color: color-mix(in srgb, var(--tone) 70%, #59708b); }
.signal-states { display: flex; flex-wrap: wrap; gap: 10px; margin-top: auto; padding-top: 12px; font-family: var(--font-mono); font-size: .55rem; color: #50667f; }
.signal-states span:first-child { color: var(--tone); }.card-arrow { position: absolute; right: 14px; bottom: 13px; color: #49617a; }
@media (max-width: 1024px) { .signals-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 640px) { .signals-grid { grid-template-columns: 1fr 1fr; } .signals-heading-right .pager { display: none; } }
</style>
