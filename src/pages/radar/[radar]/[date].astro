---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ContextNavigation from '../../../components/ContextNavigation.astro';
import { getTopicLabel, isCanonicalTopic, topicSlugsForRadar } from '../../../data/topics';
import { getRelatedResearch, getRelatedTopics, loadRelationContext } from '../../../lib/relations';

export async function getStaticPaths() {
  const entries = await getCollection('radar', ({ data }) => data.publish);
  return entries.map((entry) => ({
    params: { radar: entry.data.radar, date: entry.data.date.toISOString().slice(0, 10) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter(h => h.depth === 2);
const date = entry.data.date.toISOString().slice(0, 10);
const topicSlugs = topicSlugsForRadar(entry);
const canonicalTopics = topicSlugs.filter(isCanonicalTopic);
const historicalTopics = topicSlugs.filter((slug) => !isCanonicalTopic(slug));
const relatedResearch = getRelatedResearch(entry, await loadRelationContext());
const relatedTopics = getRelatedTopics(entry);
---

<Base title={`${entry.data.title} — Horizon`} description={entry.data.description ?? entry.data.verdict}>
  <article class="radar-report container">
    <header>
      <p class="eyebrow">{entry.data.radar.toUpperCase()} RADAR　/　DAILY</p>
      <p class="report-date">{date.replaceAll('-', '.')}</p>
      <h1>{entry.data.title}</h1>
      <p class="description">{entry.data.description ?? entry.data.verdict}</p>
      {canonicalTopics.length > 0 && (
        <nav class="topic-tags" aria-label="长期议题">
          {canonicalTopics.slice(0, 2).map((slug) => <a href={`/topics/${slug}/`}>{getTopicLabel(slug)}</a>)}
        </nav>
      )}
      <details class="article-info"><summary>内容标签与事件标记</summary>
      {(historicalTopics.length > 0 || (entry.data.tags?.length ?? 0) > 0 || (entry.data.events?.length ?? 0) > 0) && (
        <div class="secondary-metadata" aria-label="内容标记">
          {historicalTopics.map((slug) => <a href={`/topics/${slug}/`} title="历史主题标记">{slug}</a>)}
          {entry.data.tags?.map((tag) => <span>{tag}</span>)}
          {entry.data.events?.map((event) => <code>{event}</code>)}
        </div>
      )}
      </details>
      <dl class="metrics"><div><dt>信号</dt><dd>{entry.data.signalCount}</dd></div><div><dt>重点</dt><dd>{entry.data.highSignalCount}</dd></div><div><dt>需处理</dt><dd>{entry.data.actionRequired}</dd></div></dl>
    </header>
    {sections.length > 0 && <details class="report-contents" open><summary>本期目录</summary><nav aria-label="日报目录">{sections.map(h => <a href={`#${h.slug}`}>{h.text} <span aria-hidden="true">↓</span></a>)}</nav></details>}
    <div class="prose"><Content /></div>
    <ContextNavigation kind="radar" topics={relatedTopics} research={relatedResearch} />
  </article>
</Base>

<style>
.radar-report { max-width: 1000px; padding-top: 82px; padding-bottom: 112px; }.eyebrow { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .08em; color: var(--accent-text); }.report-date { margin-top: 16px; font-family: var(--font-mono); font-size: 1rem; color: var(--text-tertiary); }.radar-report h1 { margin-top: 10px; font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1.1; letter-spacing: -.045em; }.description { margin-top: 14px; color: var(--text-secondary); font-size: 1.05rem; }.metrics { display: flex; gap: 0; margin-top: 34px; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--bg-surface); }.metrics div { flex: 1; padding: 17px 20px; border-right: 1px solid var(--border-subtle); }.metrics div:last-child { border-right: 0; }.metrics dt { font-family: var(--font-mono); font-size: .59rem; letter-spacing: .07em; color: var(--text-tertiary); }.metrics dd { margin-top: 6px; font-size: 1.65rem; font-weight: 700; }.highlight-list { margin-top: 32px; border-top: 1px solid var(--border-subtle); }.highlight-list > h2 { padding: 15px 0; font: .65rem var(--font-mono); letter-spacing: .08em; color: var(--text-tertiary); }.highlight-row { display: grid; grid-template-columns: 110px minmax(0, 1fr) auto; gap: 14px; align-items: center; padding: 13px 4px; border-top: 1px solid var(--border-subtle); }.highlight-row > div { display: flex; flex-direction: column; gap: 4px; font: .61rem var(--font-mono); }.highlight-level { color: var(--accent-text); }.highlight-action { color: var(--text-tertiary); }.highlight-row h3 { font-size: .8rem; font-weight: 500; }.highlight-topic { color: var(--text-tertiary); font-size: .68rem; }.highlight-topic:hover { color: var(--accent-text); }.prose { max-width: 760px; margin-top: 38px; color: var(--text-body); font-size: 1rem; line-height: 1.85; }.prose :global(h2) { margin: 42px 0 14px; color: var(--text-primary); font-size: 1.45rem; }.prose :global(p) { margin: 12px 0; }.prose :global(ul) { margin: 14px 0 14px 20px; }@media (max-width: 560px) { .metrics { flex-direction: column; }.metrics div { border-right: 0; border-bottom: 1px solid var(--border-subtle); }.metrics div:last-child { border-bottom: 0; }.highlight-row { grid-template-columns: 68px minmax(0, 1fr); }.highlight-topic { grid-column: 2; } }
.topic-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
.topic-tags a { padding: 4px 10px; border: 1px solid var(--border-subtle); border-radius: 4px; background: var(--bg-surface); color: var(--text-secondary); font-size: .73rem; }
.topic-tags a:hover { border-color: var(--accent-tech-border); color: var(--accent-text); }
.secondary-metadata { display: flex; flex-wrap: wrap; gap: 6px 12px; margin-top: 12px; color: var(--text-tertiary); font-family: var(--font-mono); font-size: .64rem; }
.secondary-metadata a, .secondary-metadata span, .secondary-metadata code { overflow-wrap: anywhere; }
.secondary-metadata a:hover { color: var(--accent-text); }
.prose { min-width: 0; overflow-wrap: anywhere; }
.prose :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; }
.prose :global(th), .prose :global(td) { padding: 7px 10px; border-bottom: 1px solid var(--border-subtle); text-align: left; white-space: nowrap; }
.highlight-level.level-critical { color: var(--signal-critical); }
.highlight-level.level-high { color: var(--signal-high); }
.highlight-level.level-medium { color: var(--signal-medium); }
.highlight-level.level-low { color: var(--signal-low); }
.highlight-action.action-action { color: var(--action); }
.highlight-action.action-test { color: var(--test); }
.highlight-action.action-watch { color: var(--watch); }
.highlight-action.action-read { color: var(--read); }
.highlight-action.action-explore { color: var(--explore); }

.radar-report { padding-top: 40px; }
.radar-report h1 { font-size: clamp(1.85rem, 4vw, 2.8rem); line-height: 1.35; }
.metrics { margin-top: 22px; background: transparent; border: 0; border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); border-radius: 0; }
.metrics div { padding: 14px 16px; }
.metrics dt { font-size: .78rem; }
.metrics dd { font-size: 1.3rem; }
.article-info { margin-top: 12px; color: var(--text-secondary); font-size: .8rem; }
.article-info summary { cursor: pointer; padding: 6px 0; }
.secondary-metadata { font-size: .75rem; }
.report-contents { margin-top: 24px; padding: 16px 0; border-bottom: 1px solid var(--border-subtle); }
.report-contents summary { cursor: pointer; font-weight: 600; font-size: .9rem; }
.report-contents nav { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 12px; }
.report-contents a { color: var(--text-secondary); font-size: .85rem; }
.report-contents a:hover { color: var(--accent-text); }
.report-contents span { color: var(--accent-text); }
.prose :global(h3) { margin: 28px 0 12px; line-height: 1.5; }
.prose :global(ol) { margin: 14px 0 14px 24px; }
.prose :global(li) { margin: 8px 0; }
.prose :global(blockquote) { padding: 12px 16px; margin: 16px 0; background: var(--bg-surface); border-left: 2px solid var(--accent-tech); color: var(--text-secondary); }
.prose :global(hr) { margin: 32px 0; border: 0; border-top: 1px solid var(--border-subtle); }
.prose :global(a) { color: var(--accent-text); text-decoration: underline; text-underline-offset: 3px; }
@media (max-width: 560px) { .metrics { flex-direction: row; } .metrics div { border-bottom: 0; border-right: 1px solid var(--border-subtle); } .metrics div:last-child { border-right: 0; } }
</style>
