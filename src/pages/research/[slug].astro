---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RelationSection from '../../components/RelationSection.astro';
import { statusLabel, confidenceLabel, formatDate } from '../../data/research';
import { getTopicLabel } from '../../data/topics';
import { getDeclaredSourceRadarHref, getRelatedRadars, getRelatedResearchByTopics, loadRelationContext } from '../../lib/relations';

// Static paths from published research
export async function getStaticPaths() {
  const entries = await getCollection('research', ({ data }) => data.publish);
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Build TOC from H2s
const tocItems = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const relations = await loadRelationContext();
const relatedRadars = getRelatedRadars(entry, relations);
const relatedResearch = getRelatedResearchByTopics(entry, relations);
const sourceRadarHref = getDeclaredSourceRadarHref(entry, relations);

const createdStr = formatDate(entry.data.created);
const updatedStr = formatDate(entry.data.updated);
const isUpdated = entry.data.updated.getTime() !== entry.data.created.getTime();
const isArchived = entry.data.status === 'archived';
const topicSlugs = [...new Set(entry.data.topics)];
---

<Base title={`${entry.data.title} — Horizon`} description={entry.data.subtitle} type="article">
  <article class="research-detail container">
    <header class="research-header">
      <p class="breadcrumb">
        <a href="/research">深度研究</a>
        <span class="sep">/</span>
        <span>{entry.data.category.join(' · ')}</span>
      </p>
      <h1>{entry.data.title}</h1>
      <p class="subtitle">{entry.data.subtitle}</p>
      {topicSlugs.length > 0 && (
        <nav class="topic-tags" aria-label="主题脉络">
          {topicSlugs.map((slug) => <a class="topic" href={`/topics/${slug}/`}>{getTopicLabel(slug)}</a>)}
        </nav>
      )}
      <div class="meta-grid">
        <div class="meta-item">
          <span class="meta-key">创建</span>
          <span class="meta-val">{createdStr}</span>
        </div>
        <div class="meta-item">
          <span class="meta-key">更新</span>
          <span class="meta-val">{isUpdated ? updatedStr : createdStr}</span>
        </div>
        <div class="meta-item">
          <span class="meta-key">状态</span>
          <span class="meta-val">{statusLabel(entry.data.status)}</span>
        </div>
        <div class="meta-item">
          <span class="meta-key">置信度</span>
          <span class="meta-val">{confidenceLabel(entry.data.confidence)}</span>
        </div>
        <div class="meta-item">
          <span class="meta-key">来源</span>
          <span class="meta-val">{sourceRadarHref ? <a href={sourceRadarHref}>{entry.data.source}</a> : entry.data.source}</span>
        </div>
      </div>
    </header>

    {isArchived && (
      <div class="archived-banner">
        本研究已停止持续更新，内容保留作为历史参考。
      </div>
    )}

    <div class="content-layout">
      <div class="prose">
        <Content />
      </div>
      {tocItems.length > 0 && (
        <>
        <aside class="toc toc-desktop">
          <p class="toc-label">文章目录</p>
          <nav>
            {tocItems.map((h) => (
              <a href={`#${h.slug}`} class={`toc-item toc-h${h.depth}`}>{h.text}</a>
            ))}
          </nav>
        </aside>
        <details class="toc-mobile">
          <summary>文章目录</summary>
          <nav>
            {tocItems.map((h) => (
              <a href={`#${h.slug}`} class={`toc-item toc-h${h.depth}`}>{h.text}</a>
            ))}
          </nav>
        </details>
        </>
      )}
    </div>

    <RelationSection id="intelligence-sources" eyebrow="EVIDENCE / RADAR" title="情报来源" items={relatedRadars} />
    <RelationSection id="related-research" eyebrow="CONTEXT / RESEARCH TRAIL" title="延伸脉络" items={relatedResearch} />
  </article>
</Base>

<style>
.research-detail { max-width: 1200px; padding-top: 64px; padding-bottom: 96px; }
.breadcrumb { font-size: .82rem; color: var(--text-tertiary); margin-bottom: 16px; }
.breadcrumb a { color: var(--text-secondary); }
.breadcrumb a:hover { color: var(--accent-tech); }
.sep { margin: 0 8px; }

.research-header h1 { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.75rem, 4vw, 2.8rem); line-height: 1.1; letter-spacing: -.03em; margin-bottom: 12px; }
.subtitle { font-size: 1.1rem; color: var(--text-secondary); margin-bottom: 20px; }
.topic-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
.topic { font-size: .75rem; color: var(--text-secondary); padding: 3px 10px; background: var(--bg-base); border: 1px solid var(--border-subtle); border-radius: 4px; }
.topic:hover { color: var(--accent-tech); border-color: var(--accent-tech); }

.meta-grid { display: flex; flex-wrap: wrap; gap: 32px; padding: 20px 0; border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); }
.meta-item { display: flex; flex-direction: column; gap: 2px; }
.meta-key { font-family: var(--font-mono); font-size: .65rem; letter-spacing: .06em; color: var(--text-tertiary); text-transform: uppercase; }
.meta-val { font-size: .85rem; color: var(--text-primary); }
.meta-val a { color: var(--accent-tech); }

.archived-banner { margin: 24px 0; padding: 16px 20px; background: rgba(245, 158, 11, .06); border: 1px solid rgba(245, 158, 11, .2); border-radius: var(--radius-sm); font-size: .88rem; color: #92400e; }

.content-layout { display: grid; grid-template-columns: 1fr 220px; gap: 48px; margin-top: 48px; }
.prose { max-width: 760px; font-size: 1rem; line-height: 1.85; color: #34445a; }
.prose :global(h2) { margin: 48px 0 16px; font-family: var(--font-display); font-weight: 400; font-size: 1.4rem; color: var(--text-primary); letter-spacing: -.02em; border-bottom: 1px solid var(--border-subtle); padding-bottom: 8px; }
.prose :global(h3) { margin: 32px 0 12px; font-size: 1.15rem; color: var(--text-primary); }
.prose :global(p) { margin: 14px 0; }
.prose :global(ul), .prose :global(ol) { margin: 14px 0 14px 24px; }
.prose :global(li) { margin: 6px 0; }
.prose :global(a) { color: var(--accent-tech); text-decoration: none; border-bottom: 1px solid var(--accent-tech-border); }
.prose :global(a:hover) { border-bottom-color: var(--accent-tech); }
.prose :global(blockquote) { margin: 20px 0; padding: 12px 20px; border-left: 3px solid var(--accent-tech); background: var(--bg-base); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; color: var(--text-secondary); }
.prose :global(table) { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: .88rem; }
.prose :global(th) { text-align: left; padding: 8px 12px; border-bottom: 2px solid var(--border-default); font-weight: 600; color: var(--text-primary); }
.prose :global(td) { padding: 8px 12px; border-bottom: 1px solid var(--border-subtle); color: var(--text-secondary); }
.prose :global(code) { font-family: var(--font-mono); font-size: .85em; padding: 2px 6px; background: var(--bg-base); border-radius: 3px; color: var(--accent-tech); }
.prose :global(pre) { margin: 20px 0; padding: 16px 20px; background: var(--bg-base); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); overflow-x: auto; font-size: .85rem; line-height: 1.6; }
.prose :global(pre code) { padding: 0; background: none; color: var(--text-primary); }
.prose :global(hr) { border: none; border-top: 1px solid var(--border-subtle); margin: 40px 0; }
.prose :global(img) { max-width: 100%; height: auto; border-radius: var(--radius-sm); margin: 20px 0; }

.toc { position: sticky; top: 88px; align-self: start; max-height: calc(100vh - 120px); overflow-y: auto; }
.toc-label { font-family: var(--font-mono); font-size: .65rem; letter-spacing: .08em; color: var(--text-tertiary); margin-bottom: 12px; }
.toc-item { display: block; font-size: .82rem; color: var(--text-tertiary); padding: 4px 0; border-left: 2px solid var(--border-subtle); padding-left: 12px; transition: color var(--transition), border-color var(--transition); }
.toc-item:hover { color: var(--accent-tech); border-left-color: var(--accent-tech); }
.toc-h3 { padding-left: 24px; font-size: .78rem; }

@media (max-width: 1024px) {
  .content-layout { grid-template-columns: 1fr; }
  .toc-desktop { display: none; }
  .toc-mobile { display: block; grid-row: 1; padding: 12px 0; }
  .prose { grid-row: 2; }
}

.toc-mobile { display: none; }
.toc-mobile summary { cursor: pointer; font-weight: 600; color: var(--text-secondary); }
.toc-mobile nav { margin-top: 12px; }
.toc-mobile[open] { padding: 16px; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); background: var(--bg-surface); }
.toc-mobile .toc-item { color: var(--text-secondary); }

@media (max-width: 768px) {
  .meta-grid { flex-direction: column; gap: 12px; }
  .prose { font-size: .95rem; }
}
</style>
