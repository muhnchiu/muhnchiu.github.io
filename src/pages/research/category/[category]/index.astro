---
import Base from '../../../../layouts/Base.astro';
import ResearchFrame from '../../../../components/ResearchFrame.astro';
import ResearchIndex from '../../../../components/ResearchIndex.astro';
import {loadResearchIndex} from '../../../../data/research-index';
import {categorySlug} from '../../../../lib/research-pagination.mjs';
export async function getStaticPaths(){const all=await loadResearchIndex();return [...new Set(all.flatMap(e=>e.data.category))].map(category=>({params:{category:categorySlug(category)},props:{all,category}}));}
const {all,category}=Astro.props;
---
<Base title={`${category}研究｜洞见 — Horizon`}><ResearchFrame><ResearchIndex {all} {category}/></ResearchFrame></Base>
