---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CollectionHero from '../../components/CollectionHero.astro';
import ResearchCard from '../../components/ResearchCard.astro';
import { formatDate } from '../../data/research';

const all = (await getCollection('research', ({ data }) => data.publish))
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return b.data.updated.getTime() - a.data.updated.getTime()
      || b.data.created.getTime() - a.data.created.getTime();
  });

const featured = all.filter((e) => e.data.featured).slice(0, 3);
const rest = all.filter((e) => !e.data.featured);

// Extract unique categories
const categories = [...new Set(all.flatMap((e) => e.data.category))].sort();

// Stats
const totalArticles = all.length;
const totalTopics = [...new Set(all.flatMap((e) => e.data.topics))].length;
const evolvingCount = all.filter((e) => e.data.status === 'evolving').length;
const lastUpdate = all[0]?.data.updated;

---

<Base title="深度研究 — Horizon" description="从每日信号出发，追踪技术背后的长期变量。">
  <section class="research-index collection-index container">
    <CollectionHero eyebrow="RESEARCH / DEEP DIVE" title="深度研究" description="从每日信号出发，追踪技术背后的长期变量。" count={totalArticles} countLabel="公开研究" />

    <div class="stats-bar">
      <div class="stat"><b>{String(totalArticles).padStart(2, '0')}</b><span>研究文章</span></div>
      <div class="stat"><b>{String(totalTopics).padStart(2, '0')}</b><span>长期议题</span></div>
      <div class="stat"><b>{String(evolvingCount).padStart(2, '0')}</b><span>持续演进</span></div>
      <div class="stat"><b>{lastUpdate ? formatDate(lastUpdate) : '—'}</b><span>最近更新</span></div>
    </div>

    {categories.length > 0 && (
      <nav class="filter-bar">
        <span class="filter-label">分类：</span>
        <a class="filter-cat" href="/research/" data-category="">全部</a>
        {categories.map((category) => (
          <a class="filter-cat" href={`/research/?category=${encodeURIComponent(category)}`} data-category={category}>{category}</a>
        ))}
      </nav>
    )}

    {featured.length > 0 && (
      <section class="featured-section">
        <div class="collection-section-heading"><div><p class="section-label">FEATURED RESEARCH</p><h2>精选研究</h2></div><span>{featured.length} 篇</span></div>
        <div class="cards-grid">
          {featured.map((entry) => <ResearchCard entry={entry} />)}
        </div>
      </section>
    )}

    {rest.length > 0 && (
      <section class="rest-section">
        <div class="collection-section-heading"><div><p class="section-label">RESEARCH ARCHIVE</p><h2>全部研究</h2></div><span>{rest.length} 篇</span></div>
        <div class="cards-grid">
          {rest.map((entry) => <ResearchCard entry={entry} />)}
        </div>
      </section>
    )}

    {all.length === 0 && (
      <div class="empty-state">
        <p>暂无公开研究</p>
        <p class="empty-sub">每日深度研究正在持续积累中。</p>
      </div>
    )}
    <div class="empty-state filtered-empty" hidden>
      <p>该分类下暂无公开研究</p>
      <p class="empty-sub">试试其他分类，或查看全部研究。</p>
    </div>
  </section>
</Base>

<script>
  const params = new URLSearchParams(window.location.search);
  const selectedCategory = params.get('category') || '';
  const cards = [...document.querySelectorAll<HTMLElement>('.research-card')];

  for (const card of cards) {
    const categories = (card.dataset.categories || '').split('|');
    card.hidden = Boolean(selectedCategory) && !categories.includes(selectedCategory);
  }

  for (const section of document.querySelectorAll<HTMLElement>('.featured-section, .rest-section')) {
    section.hidden = !section.querySelector('.research-card:not([hidden])');
  }

  const hasVisibleCards = cards.some((card) => !card.hidden);
  const filteredEmpty = document.querySelector<HTMLElement>('.filtered-empty');
  if (filteredEmpty) filteredEmpty.hidden = !selectedCategory || hasVisibleCards;

  for (const link of document.querySelectorAll<HTMLAnchorElement>('.filter-cat')) {
    const active = (link.dataset.category || '') === selectedCategory;
    link.classList.toggle('active', active);
    link.setAttribute('aria-current', active ? 'page' : 'false');
  }
</script>

<style>
.stats-bar { display: flex; flex-wrap: wrap; gap: 28px 48px; margin: 0 0 38px; padding: 27px 0; border-bottom: 1px solid var(--border-subtle); }
.stat { display: flex; flex-direction: column; gap: 4px; }
.stat b { font-family: var(--font-mono); font-size: 1.35rem; font-weight: 600; letter-spacing: -.03em; }
.stat span { font-size: .72rem; color: var(--text-tertiary); }

.filter-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 44px; }
.filter-label { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .06em; color: var(--text-tertiary); }
.filter-cat { font-size: .78rem; color: var(--text-secondary); padding: 5px 12px; border: 1px solid var(--border-subtle); border-radius: 20px; background: var(--bg-surface); }
.filter-cat:hover, .filter-cat.active { color: var(--accent-tech); border-color: var(--accent-tech-border); background: var(--accent-tech-soft); }
.research-card[hidden], .featured-section[hidden], .rest-section[hidden] { display: none; }
.filtered-empty[hidden] { display: none; }

.cards-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
@media (max-width: 768px) { .cards-grid { grid-template-columns: 1fr; } }

.empty-state { text-align: center; padding: 80px 0; }
.empty-state p { font-size: 1.1rem; color: var(--text-secondary); }
.empty-sub { margin-top: 8px; font-size: .88rem; color: var(--text-tertiary); }

.featured-section { margin-bottom: 56px; }
@media (max-width: 600px) { .stats-bar { gap: 22px 30px; }.stat { min-width: calc(50% - 20px); } }
</style>
