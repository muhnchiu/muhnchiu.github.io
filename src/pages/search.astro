---
import Base from '../layouts/Base.astro';
import ColumnCover from '../components/ColumnCover.astro';
import FieldIcon from '../components/FieldIcon.astro';
import SearchFrame from '../components/SearchFrame.astro';
import { topicRegistry } from '../data/topics';

const suggestedSlugs = ['agent-systems', 'local-ai', 'ai-coding', 'rag-knowledge', 'developer-tools', 'inference'];
const suggestions = suggestedSlugs.map((slug) => topicRegistry.find((topic) => topic.slug === slug)).filter((topic) => topic !== undefined);
---

<Base title="搜索 | Horizon" description="在 Horizon 的技术情报、深度研究、长期议题与公开工作栈之间检索信号、判断与工具。" noindex>
  <SearchFrame>
  <div class="search-page collection-index container">
    <ColumnCover title="搜索" eyebrow="SEARCH / 观测索引" description="在雷达、洞见、脉络与方略之间，找回值得留下的信号与判断。" />

    <form class="search-form" role="search" action="/search/" method="get">
      <label for="site-search-input">搜索 Horizon</label>
      <input id="site-search-input" name="q" type="search" placeholder="搜索模型、工具、议题或研究……" autocomplete="off" spellcheck="false" />
      <button type="submit" aria-label="提交搜索"><FieldIcon name="search" /><span>检索</span></button>
    </form>

    <div class="type-filters" role="group" aria-label="筛选内容类型">
      <button type="button" data-type="all" aria-pressed="true">全部</button>
      <button type="button" data-type="research" aria-pressed="false">洞见</button>
      <button type="button" data-type="radar" aria-pressed="false">雷达</button>
      <button type="button" data-type="topic" aria-pressed="false">脉络</button>
      <button type="button" data-type="stack" aria-pressed="false">方略</button>
    </div>

    <section class="search-home" id="search-home" aria-labelledby="explore-heading">
      <div class="section-heading"><p class="eyebrow">START EXPLORING</p><h2 id="explore-heading">从一条脉络开始</h2></div>
      <p class="explore-intro">从一个长期议题开始，沿着情报与研究继续追踪。</p>
      <div class="suggestions">
        {suggestions.map((topic, index) => <a href={`/topics/${topic.slug}/`}><span class="suggestion-number">{String(index + 1).padStart(2, '0')}</span><div class="suggestion-copy"><strong>{topic.name}</strong><p>{topic.description}</p></div><span class="suggestion-arrow" aria-hidden="true">↗</span></a>)}
      </div>
    </section>

    <section class="search-results" id="search-results" aria-labelledby="results-heading" hidden>
      <div class="results-heading"><div><p class="eyebrow">SEARCH RESULTS</p><h2 id="results-heading"></h2></div><span id="result-count" aria-live="polite"></span></div>
      <div class="result-list" id="result-list"></div>
      <p class="index-loading" id="index-loading" hidden>正在加载搜索索引……</p>
      <p class="no-results" id="no-results" hidden>没有找到匹配内容。试试更短的关键词，或切换内容类型。</p>
    </section>
    <p class="index-error" id="index-error" hidden>搜索索引暂时无法加载，请稍后重试。</p>
  </div>
  </SearchFrame>
</Base>

<script>
  import { rankSearch, type SearchFilter } from '../lib/search-ranking';
  import type { LocalizedText, SearchDocument } from '../lib/search-index';

  const input = document.querySelector<HTMLInputElement>('#site-search-input');
  const form = document.querySelector<HTMLFormElement>('.search-form');
  const filters = [...document.querySelectorAll<HTMLButtonElement>('.type-filters button')];
  const home = document.querySelector<HTMLElement>('#search-home');
  const results = document.querySelector<HTMLElement>('#search-results');
  const heading = document.querySelector<HTMLElement>('#results-heading');
  const count = document.querySelector<HTMLElement>('#result-count');
  const list = document.querySelector<HTMLElement>('#result-list');
  const noResults = document.querySelector<HTMLElement>('#no-results');
  const loading = document.querySelector<HTMLElement>('#index-loading');
  const error = document.querySelector<HTMLElement>('#index-error');
  const traditional = document.documentElement.lang === 'zh-Hant';
  const labels = traditional
    ? { result: '的搜尋結果', item: '項', radar: '雷達', research: '洞見', topic: '脈絡', stack: '方略', core: '核心', environment: '環境', radarCount: '篇情報', researchCount: '篇研究' }
    : { result: '的搜索结果', item: '项', radar: '雷达', research: '洞见', topic: '脉络', stack: '方略', core: '核心', environment: '环境', radarCount: '篇雷达', researchCount: '篇研究' };
  const locale = (value: LocalizedText) => traditional ? value.hant : value.hans;
  let documents: SearchDocument[] = [];
  let loaded = false;
  let filter: SearchFilter = 'all';
  if (form) form.action = traditional ? '/search/' : '/zh-hans/search/';

  function readState() {
    const parameters = new URLSearchParams(location.search);
    const type = parameters.get('type');
    filter = ['research', 'radar', 'topic', 'stack'].includes(type ?? '') ? type as SearchFilter : 'all';
    if (input) input.value = parameters.get('q') ?? '';
  }

  function writeState(push = false) {
    const parameters = new URLSearchParams();
    const query = input?.value.trim() ?? '';
    if (query) parameters.set('q', query);
    if (filter !== 'all') parameters.set('type', filter);
    const url = `${location.pathname}${parameters.size ? `?${parameters}` : ''}`;
    history[push ? 'pushState' : 'replaceState']({}, '', url);
  }

  function highlight(target: HTMLElement, value: string, alternative: string, query: string) {
    const needle = query.trim().toLocaleLowerCase();
    let start = value.toLocaleLowerCase().indexOf(needle);
    if (start < 0 && value.length === alternative.length) start = alternative.toLocaleLowerCase().indexOf(needle);
    if (!needle || start < 0) { target.textContent = value; return; }
    target.append(document.createTextNode(value.slice(0, start)));
    const mark = document.createElement('mark');
    mark.textContent = value.slice(start, start + needle.length);
    target.append(mark, document.createTextNode(value.slice(start + needle.length)));
  }

  function renderResult(item: SearchDocument, query: string): HTMLAnchorElement {
    const link = document.createElement('a');
    link.className = 'result-row';
    link.href = `${traditional ? '' : '/zh-hans'}${item.url}`;

    const side = document.createElement('div');
    side.className = 'result-side';
    const type = document.createElement('span');
    type.className = 'result-type';
    type.textContent = `${labels[item.type]} / ${item.type.toUpperCase()}`;
    side.append(type);
    if (item.date) {
      const date = document.createElement('time');
      date.dateTime = item.date;
      date.textContent = item.date.replaceAll('-', '.');
      side.append(date);
    }

    const body = document.createElement('div');
    body.className = 'result-body';
    const title = document.createElement('h3');
    highlight(title, locale(item.title), traditional ? item.title.hans : item.title.hant, query);
    body.append(title);
    const description = document.createElement('p');
    highlight(description, locale(item.description), traditional ? item.description.hans : item.description.hant, query);
    body.append(description);

    const metadata = document.createElement('div');
    metadata.className = 'result-meta';
    const parts: string[] = [];
    if (item.type === 'radar') parts.push(labels.radar, item.radarType ? locale(item.radarType) : '');
    if (item.type === 'research') parts.push(labels.research);
    if (item.type === 'topic') parts.push(labels.topic, `${item.radarCount ?? 0} ${labels.radarCount}`, `${item.researchCount ?? 0} ${labels.researchCount}`);
    if (item.type === 'stack') parts.push(labels.stack, item.core ? labels.core : labels.environment,
      item.category ? locale(item.category) : '', item.toolType?.toUpperCase() ?? '');
    for (const topic of item.topics.slice(0, 3)) parts.push(locale(topic.name));
    metadata.textContent = parts.filter(Boolean).join('  ·  ');
    body.append(metadata);
    const arrow = document.createElement('span');
    arrow.className = 'result-arrow';
    arrow.setAttribute('aria-hidden', 'true');
    arrow.textContent = '↗';
    link.append(side, body, arrow);
    return link;
  }

  function render() {
    const query = input?.value.trim() ?? '';
    for (const button of filters) button.setAttribute('aria-pressed', String(button.dataset.type === filter));
    if (home) home.hidden = Boolean(query);
    if (results) results.hidden = !query;
    if (!query || !list || !heading || !count) return;
    heading.textContent = `“${query}”${labels.result}`;
    if (loading) loading.hidden = loaded;
    if (!loaded) {
      count.textContent = '';
      list.replaceChildren();
      if (noResults) noResults.hidden = true;
      return;
    }
    const matches = rankSearch(documents, query, filter);
    count.textContent = `${matches.length} ${labels.item}`;
    list.replaceChildren(...matches.map(({ document: item }) => renderResult(item, query)));
    if (noResults) noResults.hidden = matches.length > 0;
  }

  readState();
  render();
  fetch('/search-index.json')
    .then((response) => { if (!response.ok) throw new Error(`Search index ${response.status}`); return response.json(); })
    .then((index: SearchDocument[]) => { documents = index; loaded = true; render(); })
    .catch(() => { if (loading) loading.hidden = true; if (error) error.hidden = false; });
  input?.addEventListener('input', () => { writeState(); render(); });
  form?.addEventListener('submit', (event) => { event.preventDefault(); writeState(); render(); });
  for (const button of filters) button.addEventListener('click', () => {
    filter = button.dataset.type as SearchFilter;
    writeState(true);
    render();
  });
  window.addEventListener('popstate', () => { readState(); render(); });
</script>
