---
import Base from '../../layouts/Base.astro';
import TopicsFrame from '../../components/TopicsFrame.astro';
import ColumnCover from '../../components/ColumnCover.astro';
import { loadTopics, topicGroups } from '../../data/topics';

const topics = await loadTopics();
const displayDate = (date?: Date) => date ? date.toISOString().slice(0, 10) : '尚在观察';
---

<Base title="脉络｜长期议题 — Horizon" description="不是追逐每一则新闻，而是持续追踪那些正在改变技术与工作的长期变量。">
  <TopicsFrame>
  <section class="topics-index collection-index container">
    <ColumnCover title="脉络" eyebrow="TOPICS / 长期议题" description="沿着长期议题，追踪技术变化之间的联系。" />

    <nav class="topics-nav" aria-label="议题分类">{topicGroups.map(group => <a href={`#group-${group.id}`}>{group.name}<span>{topics.filter(topic => topic.group === group.id).length}</span></a>)}</nav>
    <div class="topic-groups">
      {topicGroups.map((group) => (
        <section class="topic-group" aria-labelledby={`group-${group.id}`}>
          <div class="collection-section-heading">
            <div><p class="section-label">{group.eyebrow}</p><h2 id={`group-${group.id}`}>{group.name}</h2></div>
            <span>{String(topics.filter((topic) => topic.group === group.id).length).padStart(2, '0')} / TOPICS</span>
          </div>
          <div class="topic-grid">
            {topics.filter((topic) => topic.group === group.id).map((topic, index) => (
              <a class="topic-card" href={`/topics/${topic.slug}/`}>
                <span class="topic-number">{String(index + 1).padStart(2, '0')}</span>
                <div class="topic-entry-copy"><div class="topic-card-heading"><h3>{topic.name}</h3><span class="arrow" aria-hidden="true">↗</span></div>
                <p class="topic-description">{topic.description}</p></div>
                <div class="topic-stats">
                  <span><b>{topic.radarCount}</b> 期雷达</span>
                  <span><b>{topic.researchCount}</b> 篇研究</span>
                  <span>最近更新 <time>{displayDate(topic.latestActivity)}</time></span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
  </TopicsFrame>
</Base>
