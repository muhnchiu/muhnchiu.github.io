---
import Base from '../../layouts/Base.astro';
import { loadTopicRoutes, topicGroups } from '../../data/topics';
import { getTopicTimeline, loadRelationContext } from '../../lib/relations';

export async function getStaticPaths() {
  const [topics, relations] = await Promise.all([loadTopicRoutes(), loadRelationContext()]);
  return topics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic, timeline: getTopicTimeline(topic.slug, relations) },
  }));
}

const { topic, timeline } = Astro.props;
const displayDate = (date?: Date) => date ? date.toISOString().slice(0, 10) : '—';
const isEmpty = topic.radarCount === 0 && topic.researchCount === 0;
const groupName = topicGroups.find((group) => group.id === topic.group)?.name;
---

<Base title={`${topic.name}｜Horizon ${topic.canonical ? '长期议题' : '历史主题记录'}`} description={topic.description}>
  <article class="topic-detail container">
    <header class="topic-hero">
      <a class="back-link" href="/topics/">← 长期议题</a>
      <p class="eyebrow">{topic.canonical ? `TOPIC FILE / ${groupName}` : 'HISTORICAL TOPIC / ARCHIVE'}</p>
      <h1>{topic.name}</h1>
      <code class="slug">{topic.slug}</code>
      <p class="description">{topic.description}</p>
      {!topic.canonical && <p class="historical-note">这是旧内容中的历史标记，未纳入正式长期议题。</p>}
      <div class="overview">
        <div><b>{topic.radarCount}</b><span>Radar Signals</span></div>
        <div><b>{topic.researchCount}</b><span>Research</span></div>
        <div><b>{displayDate(topic.latestActivity)}</b><span>Last Updated</span></div>
      </div>
    </header>

    {timeline.length > 0 && (
      <section class="content-section timeline-section" aria-labelledby="topic-timeline-heading">
        <header class="section-heading">
          <div><p class="eyebrow">SIGNAL / RESEARCH / CONTEXT</p><h2 id="topic-timeline-heading">近期演进</h2></div>
          <span>最新 {timeline.length} 条</span>
        </header>
        <div class="timeline-list">
          {timeline.map((item) => (
            <a class="timeline-row" href={item.href}>
              <time>{displayDate(item.date)}</time>
              <span class="timeline-kind">{item.kind === 'radar' ? '情报' : '研究'}</span>
              <span class="timeline-copy"><strong>{item.title}</strong><small>{item.summary}</small></span>
              <span class="timeline-source">{item.source}</span>
              <span class="timeline-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {isEmpty && <div class="topic-empty">这个议题正在观察中，尚未形成足够的研究记录。</div>}

    {!isEmpty && <section class="content-section" aria-labelledby="topic-research-heading">
      <header class="section-heading">
        <div><p class="eyebrow">RESEARCH / LONG-TERM VIEW</p><h2 id="topic-research-heading">研究专题</h2></div>
        <span>{topic.researchCount} 篇</span>
      </header>
      {topic.relatedResearch.length ? (
        <div class="content-list">
          {topic.relatedResearch.map((entry) => (
            <a class="content-row" href={`/research/${entry.data.slug}/`}>
              <div class="row-meta"><span>RESEARCH</span><time>{displayDate(entry.data.updated)}</time></div>
              <div class="row-copy"><h3>{entry.data.title}</h3><p>{entry.data.subtitle}</p><small>{entry.data.category.join(' · ')} · {entry.data.source}</small></div>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="section-empty">这个主题尚无已发布研究，先从每日情报观察信号。</p>
      )}
    </section>}

    {!isEmpty && <section class="content-section" aria-labelledby="topic-radar-heading">
      <header class="section-heading">
        <div><p class="eyebrow">RADAR / DAILY SIGNALS</p><h2 id="topic-radar-heading">每日情报</h2></div>
        <span>{topic.radarCount} 期</span>
      </header>
      {topic.relatedRadarReports.length ? (
        <div class="content-list">
          {topic.relatedRadarReports.map((report) => (
            <a class="content-row" href={report.href}>
              <div class="row-meta"><span>RADAR</span><time>{displayDate(report.date)}</time></div>
              <div class="row-copy"><h3>{report.title}</h3><p>{report.verdict}</p><small>{report.radarLabel}{report.matchedHighlights.length > 0 && ` · ${report.matchedHighlights.length} 条相关重点信号`}</small></div>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="section-empty">这个主题尚无已发布 Radar 日报。</p>
      )}
    </section>}

    {topic.relatedTopics.length > 0 && (
      <section class="content-section related-section" aria-labelledby="related-topics-heading">
        <header class="section-heading"><div><p class="eyebrow">KNOWLEDGE / CONNECTIONS</p><h2 id="related-topics-heading">相关主题</h2></div></header>
        <div class="related-list">
          {topic.relatedTopics.map((related) => (
            <a href={`/topics/${related.slug}/`}><span>{related.name}</span><code>{related.slug}</code><small>共同出现 {related.coOccurrenceCount} 次　→</small></a>
          ))}
        </div>
      </section>
    )}
  </article>
</Base>

<style>
.topic-detail { max-width: 1040px; padding-top: 58px; padding-bottom: 112px; }
.back-link { color: var(--text-tertiary); font-size: .75rem; }.back-link:hover { color: var(--accent-tech); }
.topic-hero { padding: 28px 0 32px; border-bottom: 1px solid var(--border-subtle); }
.eyebrow { font-family: var(--font-mono); font-size: .63rem; letter-spacing: .09em; color: var(--accent-tech); }
.topic-hero > .eyebrow { margin-top: 22px; }
.topic-hero h1 { margin-top: 8px; font-family: var(--font-display); font-weight: 400; font-size: clamp(2.25rem, 5vw, 3.8rem); line-height: 1.08; letter-spacing: -.04em; }
.slug { display: inline-block; margin-top: 8px; color: var(--text-tertiary); font-size: .7rem; overflow-wrap: anywhere; }
.description { max-width: 700px; margin-top: 16px; color: var(--text-secondary); font-size: .95rem; line-height: 1.7; }
.historical-note { max-width: 700px; margin-top: 15px; padding-left: 12px; border-left: 2px solid var(--border-default); color: var(--text-tertiary); font-size: .76rem; line-height: 1.6; }
.topic-empty { margin-top: 44px; padding: 34px 24px; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--bg-surface); color: var(--text-secondary); font-size: .87rem; line-height: 1.7; }
.overview { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 28px; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--bg-surface); }
.overview div { padding: 17px 20px; border-right: 1px solid var(--border-subtle); }.overview div:last-child { border-right: 0; }
.overview b { display: block; font-family: var(--font-mono); font-size: 1.45rem; }.overview span { display: block; margin-top: 5px; color: var(--text-tertiary); font-size: .68rem; }
.content-section { padding-top: 45px; }
.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 14px; }.section-heading h2 { margin-top: 5px; font-family: var(--font-display); font-weight: 400; font-size: 1.38rem; }.section-heading > span { color: var(--text-tertiary); font-size: .7rem; }
.content-list,.related-list { border-top: 1px solid var(--border-subtle); }
.content-row { display: grid; grid-template-columns: 128px minmax(0, 1fr) 18px; gap: 20px; align-items: start; padding: 19px 8px; border-bottom: 1px solid var(--border-subtle); }.content-row:hover { color: inherit; background: var(--bg-surface); }
.row-meta { display: flex; flex-direction: column; gap: 7px; color: var(--text-tertiary); font-family: var(--font-mono); font-size: .65rem; }.row-meta span { color: var(--accent-tech); letter-spacing: .06em; }
.row-copy h3 { font-size: .93rem; font-weight: 600; line-height: 1.45; }.row-copy p { margin-top: 6px; color: var(--text-secondary); font-size: .8rem; line-height: 1.55; }.row-copy small { display: block; margin-top: 8px; color: var(--text-tertiary); font-size: .68rem; }
.timeline-list { border-top: 1px solid var(--border-subtle); }
.timeline-row { display: grid; grid-template-columns: 105px 48px minmax(0, 1fr) 120px 14px; align-items: start; gap: 14px; padding: 18px 5px; border-bottom: 1px solid var(--border-subtle); }
.timeline-row:hover { color: inherit; background: var(--bg-surface); }
.timeline-row time, .timeline-source { color: var(--text-tertiary); font-family: var(--font-mono); font-size: .66rem; }
.timeline-kind { color: var(--accent-tech); font-size: .7rem; }
.timeline-copy { display: flex; flex-direction: column; min-width: 0; }
.timeline-copy strong { font-size: .9rem; font-weight: 600; line-height: 1.45; }
.timeline-copy small { margin-top: 5px; color: var(--text-secondary); font-size: .76rem; line-height: 1.5; }
.timeline-source { text-align: right; overflow-wrap: anywhere; }
.timeline-arrow { color: var(--text-tertiary); }
.arrow { color: var(--text-tertiary); text-align: right; }.section-empty { padding: 23px 8px; border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); color: var(--text-tertiary); font-size: .8rem; }
.related-list a { display: grid; grid-template-columns: 1fr 1fr auto; gap: 14px; align-items: center; padding: 13px 8px; border-bottom: 1px solid var(--border-subtle); }.related-list code,.related-list small { color: var(--text-tertiary); font-size: .65rem; }.related-list small { text-align: right; }
@media (max-width: 720px) { .topic-detail { padding-top: 38px; }.overview div { padding: 14px 12px; }.overview b { font-size: 1.1rem; }.content-row { grid-template-columns: minmax(0, 1fr) 18px; gap: 9px; }.row-meta { grid-column: 1; flex-direction: row; gap: 12px; }.row-copy { grid-column: 1; }.content-row .arrow { grid-column: 2; grid-row: 1 / span 2; }.related-list a { grid-template-columns: 1fr auto; }.related-list code { grid-column: 1; }.related-list small { grid-column: 2; grid-row: 1 / span 2; } }
@media (max-width: 460px) { .overview { grid-template-columns: 1fr; }.overview div { border-right: 0; border-bottom: 1px solid var(--border-subtle); }.overview div:last-child { border-bottom: 0; } }
@media (max-width: 720px) { .timeline-row { grid-template-columns: 1fr auto; gap: 6px 12px; }.timeline-row time { grid-column: 1; }.timeline-kind { grid-column: 2; grid-row: 1; text-align: right; }.timeline-copy { grid-column: 1 / -1; }.timeline-source { grid-column: 1; text-align: left; }.timeline-arrow { grid-column: 2; grid-row: 3; text-align: right; } }
</style>
