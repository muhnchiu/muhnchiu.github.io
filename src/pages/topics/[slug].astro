---
import Base from '../../layouts/Base.astro';
import { loadTopicRegistry } from '../../data/topics';
import { formatRadarDate } from '../../data/radar';

export async function getStaticPaths() {
  const { topics } = await loadTopicRegistry();
  return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const radarNames: Record<string, string> = { ai: 'AI', dev: 'Developer', security: 'Security', app: 'App', skill: 'Skill' };
const description = topic.description ?? `Horizon 关于 ${topic.name} 的长期技术信号与研究记录。`;
---

<Base title={`${topic.name} — Horizon 长期议题`} description={description}>
  <article class="topic-detail container">
    <header class="topic-hero">
      <a class="back-link" href="/topics">← 长期议题</a>
      <p class="eyebrow">TECHNOLOGY INTELLIGENCE MAP</p>
      <div class="hero-title">
        <div><h1>{topic.name}</h1>{topic.description && <p class="description">{topic.description}</p>}</div>
        <span class={`status status-${topic.status.id}`}>{topic.status.label}</span>
      </div>
      <div class="overview-grid">
        <div><b>{topic.totalSignals}</b><span>累计 Signals</span></div>
        <div><b>{topic.signals7d}</b><span>近 7 日 Signals</span></div>
        <div><b>{topic.signals30d}</b><span>近 30 日 Signals</span></div>
        <div><b>{topic.totalResearch}</b><span>累计 Research</span></div>
        <div><b>{topic.research30d}</b><span>近 30 日 Research</span></div>
        <div><b>{topic.firstSeenLabel ?? '—'}</b><span>首次发现</span></div>
        <div><b>{topic.lastActivityLabel ?? '—'}</b><span>最近活跃</span></div>
      </div>
    </header>

    <section class="current-state">
      <div><p class="section-label">当前状态</p><h2>{topic.status.label}</h2></div>
      <p>最近 30 天出现 {topic.signals30d} 条 Radar Signals、{topic.research30d} 篇 Research。<br />最近一次活动：{topic.lastActivityLabel ?? '暂无记录'}。</p>
    </section>

    <section class="coverage-row">
      <div><p class="section-label">知识覆盖</p><h2>{topic.coverage.label}</h2><p>{topic.totalSignals} 条明确关联的 Signals · {topic.totalResearch} 篇公开 Research</p></div>
      <span class={`coverage-badge coverage-${topic.coverage.id}`}>{topic.coverage.id.toUpperCase()}</span>
    </section>

    <section class="timeline-section">
      <header class="section-heading"><div><p class="section-label">TOPIC TIMELINE</p><h2>发展脉络</h2></div><span>{topic.timeline.length} 条记录</span></header>
      {topic.timeline.length ? (
        <ol class="timeline">
          {topic.timeline.map((item) => (
            <li class="timeline-item">
              <time>{item.date.toISOString().slice(0, 10).replaceAll('-', '.')}</time>
              {item.kind === 'signal' ? (
                <a class="timeline-entry" href={`/radar/${item.radar}/${formatRadarDate(item.date)}`}>
                  <span class="entry-kind">SIGNAL · {radarNames[item.radar] ?? item.radar.toUpperCase()}</span>
                  <strong>{item.title}</strong><span class="entry-arrow" aria-hidden="true">→</span>
                </a>
              ) : (
                <a class="timeline-entry research-entry" href={`/research/${item.slug}`}>
                  <span class="entry-kind">RESEARCH</span>
                  <strong>{item.title}</strong><span class="entry-arrow" aria-hidden="true">→</span>
                </a>
              )}
            </li>
          ))}
        </ol>
      ) : <p class="empty-state">还没有明确标记到此议题的 Radar Signal 或 Research。</p>}
    </section>

    <div class="lower-grid">
      <section class="related-section">
        <header class="section-heading"><div><p class="section-label">CO-OCCURRING TOPICS</p><h2>相关议题</h2></div></header>
        {topic.relatedTopics.length ? <div class="related-list">{topic.relatedTopics.map((related) => <a href={`/topics/${related.slug}`}><span>{related.name}</span><small>共现 {related.coOccurrenceCount} 次　→</small></a>)}</div> : <p class="empty-state">暂未发现共现议题。</p>}
      </section>

      <section class="distribution-section">
        <header class="section-heading"><div><p class="section-label">SIGNAL SOURCES</p><h2>信号来源</h2></div></header>
        {topic.radarDistribution.length ? <div class="distribution-list">{topic.radarDistribution.map((item) => <div class="distribution-item"><div><span>{item.name}</span><b>{item.count}</b></div><div class="bar"><span style={`width: ${item.percent}%`}></span></div></div>)}</div> : <p class="empty-state">暂无明确关联的 Radar 信号。</p>}
      </section>
    </div>
  </article>
</Base>

<style>
.topic-detail { max-width: 1060px; padding-top: 54px; padding-bottom: 112px; }
.back-link { color: var(--text-tertiary); font-size: .75rem; }.back-link:hover { color: var(--accent-tech); }
.eyebrow,.section-label { font-family: var(--font-mono); font-size: .65rem; letter-spacing: .1em; color: var(--accent-tech); }
.topic-hero { margin-top: 30px; padding-bottom: 34px; border-bottom: 1px solid var(--border-subtle); }
.hero-title { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-top: 10px; }
.hero-title h1 { font-size: clamp(2.3rem, 5vw, 4rem); letter-spacing: -.05em; line-height: 1.06; }
.description { max-width: 700px; margin-top: 12px; color: var(--text-secondary); line-height: 1.65; }
.status { flex: 0 0 auto; margin-top: 8px; padding: 6px 10px; border-radius: 999px; font-family: var(--font-mono); font-size: .65rem; color: #315d88; background: #edf6ff; }.status-hot { color: #a33b39; background: #fff0ed; }.status-active { color: #126b65; background: #eaf8f4; }.status-quiet { color: var(--text-tertiary); background: var(--bg-base); }
.overview-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 28px; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--bg-surface); overflow: hidden; }
.overview-grid div { min-height: 82px; padding: 15px 18px; border-right: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); }.overview-grid b { display: block; font-family: var(--font-mono); font-size: 1.22rem; }.overview-grid span { display: block; margin-top: 6px; color: var(--text-tertiary); font-size: .66rem; }
.current-state,.coverage-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 25px 0; border-bottom: 1px solid var(--border-subtle); }.current-state h2,.coverage-row h2 { margin-top: 7px; font-size: 1.12rem; }.current-state > p,.coverage-row > div > p:last-child { color: var(--text-secondary); font-size: .8rem; line-height: 1.7; text-align: right; }
.coverage-badge { padding: 7px 10px; border: 1px solid var(--border-subtle); border-radius: 4px; font: .62rem var(--font-mono); color: var(--text-tertiary); }.coverage-researching { color: #176a64; background: #edf8f5; }.coverage-established { color: #315d88; background: #edf6ff; }
.timeline-section,.related-section,.distribution-section { padding-top: 38px; }.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 15px; }.section-heading h2 { margin-top: 5px; font-size: 1.18rem; }.section-heading > span { color: var(--text-tertiary); font-size: .68rem; }
.timeline { list-style: none; padding: 0; border-top: 1px solid var(--border-subtle); }.timeline-item { display: grid; grid-template-columns: 100px minmax(0, 1fr); gap: 16px; padding: 15px 0; border-bottom: 1px solid var(--border-subtle); }.timeline-item > time { padding-top: 12px; font: .68rem var(--font-mono); color: var(--text-tertiary); }.timeline-entry { display: grid; grid-template-columns: 140px minmax(0, 1fr) 20px; align-items: center; gap: 12px; padding: 8px 12px; border-radius: var(--radius-sm); }.timeline-entry:hover { color: inherit; background: var(--bg-surface); }.entry-kind { font: .61rem var(--font-mono); letter-spacing: .04em; color: var(--accent-tech); }.timeline-entry strong { font-size: .82rem; font-weight: 500; line-height: 1.5; }.entry-arrow { color: var(--text-tertiary); text-align: right; }
.lower-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border-subtle); }.related-list,.distribution-list { border-top: 1px solid var(--border-subtle); }.related-list a { display: flex; justify-content: space-between; gap: 12px; padding: 13px 0; border-bottom: 1px solid var(--border-subtle); font-size: .8rem; }.related-list small { color: var(--text-tertiary); font-size: .65rem; }.distribution-item { padding: 11px 0; border-bottom: 1px solid var(--border-subtle); }.distribution-item > div:first-child { display: flex; justify-content: space-between; font-size: .75rem; }.distribution-item b { font-family: var(--font-mono); }.bar { height: 4px; margin-top: 7px; border-radius: 4px; background: var(--bg-base); overflow: hidden; }.bar span { display: block; height: 100%; background: var(--accent-tech); border-radius: inherit; }
.empty-state { padding: 20px 0; color: var(--text-tertiary); font-size: .8rem; }
@media (max-width: 700px) { .topic-detail { padding-top: 38px; }.hero-title { flex-direction: column; }.overview-grid { grid-template-columns: repeat(2, 1fr); }.current-state,.coverage-row { align-items: flex-start; flex-direction: column; }.current-state > p,.coverage-row > div > p:last-child { text-align: left; }.timeline-item { grid-template-columns: 1fr; gap: 4px; }.timeline-item > time { padding-left: 12px; }.timeline-entry { grid-template-columns: 1fr 20px; gap: 5px 10px; }.entry-kind { grid-column: 1; }.timeline-entry strong { grid-column: 1; }.entry-arrow { grid-column: 2; grid-row: 1 / span 2; }.lower-grid { grid-template-columns: 1fr; gap: 8px; } }
</style>
