{
  "artifact": "radar-score-input-generation-policy-v2.1-candidate",
  "policyVersion": "2.1.0-candidate",
  "status": "DRAFT",
  "normative": false,
  "supersedes": "radar-score-input-policy-v1-draft for candidate score 2.1 input semantics only",
  "authority": "One per-field authority as declared in radar-score-input-authority-map-v2.1.json.",
  "semanticBoundary": "Score Input Generation creates and validates provenance-carrying inputs only. It does not change Score/Signal/Filter/Action formulas, Event/Observation identity, Registry state, risk semantics or priorValidation lifecycle.",
  "generationMethods": [
    "DETERMINISTIC",
    "MODEL_JUDGMENT",
    "HUMAN_AUTHORITY",
    "DERIVED"
  ],
  "requiredFields": [
    "relevanceLevel",
    "impact",
    "actionability",
    "confidence",
    "novelty",
    "momentum",
    "relevanceScore",
    "radarModifier",
    "radar",
    "title",
    "entity",
    "securityGate",
    "risk",
    "priorValidation",
    "duplicate",
    "eventType",
    "eventClass",
    "sourceAuthority"
  ],
  "conditionalFields": [
    "securityEscalation"
  ],
  "contextFields": [
    "radar",
    "title",
    "entity",
    "eventClass",
    "eventState",
    "sourceAuthority",
    "candidateObservationObservedAt"
  ],
  "fieldProvenance": "Every required/conditional generated input has one schema-valid field-level provenance envelope. Authority cannot be absent/UNKNOWN. Deterministic requires policyVersion+ruleId; model judgment requires rubricVersion+model/provider/config/evidence; human authority requires a human validation lookup/record; derived requires policyVersion+derivedFrom.",
  "riskGeneration": {
    "architecture": "HYBRID",
    "deterministicFirst": true,
    "modelFallback": "Only when deterministic facts/rules are insufficient; fixed rubric and cited evidence only.",
    "precedence": "Decisive deterministic safety facts always win. Model cannot override them. Conflicting authoritative facts => RISK_UNRESOLVED.",
    "missing": "RISK_UNRESOLVED; do not map missing to normal."
  },
  "priorValidation": {
    "generationMethod": "HUMAN_AUTHORITY",
    "primaryAuthority": "HUMAN_VALIDATION_REGISTRY",
    "authority": "EXPLICIT_HUMAN_VALIDATION",
    "lifecycle": [
      "ACTIVE",
      "STALE",
      "REVOKED"
    ],
    "projection": "ACTIVE=true; STALE/REVOKED/no matching row after complete healthy lookup=false; authority unavailable/conflicting=unresolved.",
    "automaticActiveCreation": "NO",
    "forbiddenCreationSources": [
      "Radar output",
      "Registry state",
      "model output",
      "score output",
      "action history",
      "duplicate history"
    ]
  },
  "eventStateBoundary": "eventState and duplicate originate only from committed Event/Observation Registry result. Score Policy consumes them and cannot generate or mutate them.",
  "eligibilityResolver": {
    "name": "resolveScoreInputEligibility(candidate)",
    "fieldStatuses": [
      "READY",
      "MISSING_PROVENANCE",
      "MISSING_AUTHORITY",
      "MISSING_VERSION",
      "MISSING_EVIDENCE",
      "MISSING_TIME_RELATION",
      "INVALID_VALUE"
    ],
    "order": [
      "INVALID_VALUE",
      "MISSING_PROVENANCE",
      "MISSING_AUTHORITY",
      "MISSING_VERSION",
      "MISSING_EVIDENCE",
      "MISSING_TIME_RELATION",
      "READY"
    ],
    "semantics": "For each required field, validate target value first, then existence and field match of provenance, known non-UNKNOWN authority and ownership, method-specific version, required evidence/derived inputs, and observedAt relationship + conditional timestamps. Return the first status from the ordered checks and all diagnostics. Candidate is SCORE_READY iff every required field is READY and all conditional fields are valid; otherwise RECEIPT_ONLY. No partial scoring, defaults, guessing or V1 signal/action/confidence reverse mapping.",
    "implementation": "src/lib/radar-score-input/eligibility.ts",
    "failureOrder": [
      "MISSING_PROVENANCE",
      "MISSING_AUTHORITY",
      "MISSING_VERSION",
      "MISSING_EVIDENCE",
      "MISSING_TIME_RELATION",
      "INVALID_VALUE"
    ],
    "successAndFailure": {
      "eligible": "SCORE_READY",
      "ineligible": "RECEIPT_ONLY",
      "partialScoring": false
    }
  },
  "stages": {
    "preRegistry": "Collect source-owned evidence; preserve URLs/timestamps; normalize; resolve identity and all non-Registry-owned Score Inputs. If an input is known unresolved, do not invoke Score Policy or commit a candidate solely for scoring.",
    "registry": "Event/Observation Registry atomically resolves and commits state under its own policy. Score generation does not write Registry.",
    "postRegistry": "Consume committed duplicate/EventState, complete provenance validation, then invoke Score Policy once. Registry transaction failure or missing result => RECEIPT_ONLY; no prediction."
  },
  "noPartialScoring": true,
  "noV1ReverseMapping": [
    "signal",
    "action",
    "reportConfidence"
  ],
  "productionEligibility": "SCORE_READY only when every required field is READY; all else RECEIPT_ONLY.",
  "provenanceSchemaPath": "radar-score-input-provenance-schema-v2.1.json",
  "authorityMapPath": "#/authorityMap",
  "calibrationSchemaPath": "radar-score-calibration-dataset-schema-v2.1.json",
